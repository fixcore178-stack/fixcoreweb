---
import BaseHead from '../components/BaseHead.astro';
import Ambient from '../components/Ambient.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { WHATSAPP_URL } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead {...props} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Ambient />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<a class="fab" data-fab href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Message FixCore Tech on WhatsApp">
			<BrandIcon name="whatsapp" size={26} />
		</a>

		<script>
			import '../scripts/site.ts';
		</script>
	</body>
</html>

<style>
	main {
		display: block;
	}
	.fab {
		position: fixed;
		right: clamp(1rem, 3vw, 1.75rem);
		bottom: clamp(1rem, 3vw, 1.75rem);
		z-index: 40;
		display: grid;
		place-items: center;
		width: 3.6rem;
		height: 3.6rem;
		border-radius: 50%;
		background: var(--wa);
		color: var(--on-wa);
		box-shadow: none;
		opacity: 0;
		transform: translateY(16px) scale(0.85);
		pointer-events: none;
		/* Hidden from keyboard and screen readers too until it is shown; visibility flips after the fade-out */
		visibility: hidden;
		transition:
			opacity 0.4s var(--ease),
			transform 0.5s var(--ease),
			background-color 0.2s,
			visibility 0s linear 0.5s;
	}
	.fab:global(.show) {
		opacity: 1;
		transform: none;
		pointer-events: auto;
		visibility: visible;
		transition-delay: 0s, 0s, 0s, 0s;
	}
	.fab:hover {
		color: var(--on-wa);
		background: var(--wa-hover);
		transform: translateY(-3px) scale(1.05);
	}
	@media (prefers-reduced-motion: reduce) {
		.fab {
			opacity: 1;
			transform: none;
			pointer-events: auto;
			visibility: visible;
		}
	}
</style>
