---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, WHATSAPP_URL, INSTAGRAM_URL, FACEBOOK_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="FixCore is a tech repair business in Trinidad & Tobago."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="top">
				<div class="wrap">
					<h1>About FixCore</h1>
				</div>
			</section>
			<section class="body">
				<div class="wrap copy">
					<p>
						FixCore is a tech repair business in Trinidad &amp; Tobago. We fix the phones, laptops and
						other devices you rely on every day, so you don't have to replace them.
					</p>
					<p>
						Not sure what's wrong, or whether it's worth repairing? Describe the problem and we'll
						tell you what we can do.
					</p>
					<p class="actions">
						<a class="btn btn-wa" href={WHATSAPP_URL} target="_blank" rel="noopener">Message us on WhatsApp</a>
						<a class="btn btn-dark" href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
						<a class="btn btn-dark" href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.top {
		background-color: var(--blue);
		background-image:
			linear-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px);
		background-size: 56px 56px;
		color: #fff;
		padding-block: clamp(3rem, 8vw, 6rem);
	}
	h1 {
		font-size: clamp(2.75rem, 8vw, 6rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
	}
	.body {
		padding-block: clamp(3rem, 7vw, 5rem);
	}
	.copy {
		font-size: 1.2rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
		max-width: none;
	}
	.btn-dark {
		border-color: var(--ink);
		color: var(--ink);
	}
	.btn-dark:hover {
		background: var(--mist);
		color: var(--ink);
	}
</style>
