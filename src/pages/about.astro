---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, WHATSAPP_URL, INSTAGRAM_URL, FACEBOOK_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="FixCore is a tech repair business in Trinidad & Tobago."
		/>
	</head>
	<body>
		<Header />
		<main class="wrap page">
			<h1>About FixCore</h1>
			<div class="copy">
				<p>
					FixCore is a tech repair business in Trinidad &amp; Tobago. We fix the phones, laptops and
					other devices you rely on every day, so you don't have to replace them.
				</p>
				<p>
					Not sure what's wrong, or whether it's worth repairing? Describe the problem and we'll
					tell you what we can do.
				</p>
				<p>
					Reach us on <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>,
					<a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a> or
					<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(4rem, 9vw, 7rem);
	}
	h1 {
		font-size: clamp(2.75rem, 9vw, 7rem);
		margin-bottom: 0.6em;
	}
	.copy {
		margin-left: auto;
		max-width: 34em;
		font-size: 1.15rem;
	}
	@media (max-width: 720px) {
		.copy {
			margin-left: 0;
		}
	}
</style>
