---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
import { business, team } from '../data/site';

const principles = [
	{ icon: 'chat', title: 'Talk first', text: 'Every job starts with a conversation on WhatsApp. You tell us what is going on and we tell you what we can do.' },
	{ icon: 'quote', title: 'Quote before work', text: 'You see what it needs and what it costs before anything starts.' },
	{ icon: 'shield', title: 'Honest answers', text: 'If a repair is not worth it or we cannot do it, we will say so.' },
] as const;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: `About ${SITE_TITLE}`,
	url: `${SITE_URL}/about`,
	about: { '@type': 'LocalBusiness', name: SITE_TITLE, url: SITE_URL },
};
---

<Base
	title={`About | ${SITE_TITLE}`}
	description={`${SITE_TITLE} is a local tech repair business in ${business.serviceArea}. Learn how we work and how to get a quote.`}
	schema={schema}
>
	<section class="top">
		<div class="wrap">
			<span class="eyebrow reveal">About us</span>
			<h1 class="reveal-lines">
				<span class="line" style="--i:0"><span>Local repairs,</span></span>
				<span class="line" style="--i:1"><span class="grad">done properly.</span></span>
			</h1>
		</div>
	</section>

	<section class="section story">
		<div class="wrap story-grid">
			<div class="copy reveal">
				<p class="lead big">
					{SITE_TITLE} is a local tech repair business in {business.serviceArea}. We fix the phones and laptops
					you rely on every day, so you do not have to replace them.
				</p>
				<p>
					Not sure what is wrong, or whether it is worth repairing? Describe the problem and we will tell you what we
					can do. Our aim is simple: clear answers, a fair quote and a device that works again.
				</p>
				<div class="cta-row">
					<a class="btn btn-primary" href="/#quote">
						Get a quote <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
					</a>
					<a class="btn btn-glass" href="/services">See our services</a>
				</div>
			</div>

			<ul class="rules">
				{
					principles.map((p, i) => (
						<li class="reveal" style={`--d:${i}`}>
							<article class="glass glow" data-tilt="3">
								<span class="ico"><Icon name={p.icon} size={24} /></span>
								<div>
									<h2>{p.title}</h2>
									<p>{p.text}</p>
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		team.length > 0 && (
			<section class="section">
				<div class="wrap">
					<div class="section-head reveal">
						<span class="eyebrow">The team</span>
						<h2>The people behind <span class="grad">{SITE_TITLE}</span>.</h2>
					</div>
					<ul class="team">
						{team.map((m, i) => (
							<li class="reveal" style={`--d:${i % 3}`}>
								<article class="glass">
									<h3>{m.name}</h3>
									<p class="role">{m.role}</p>
									{m.bio && <p>{m.bio}</p>}
								</article>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<CtaBand />
</Base>

<style>
	.top {
		padding: clamp(8rem, 14vw, 10.5rem) 0 1rem;
	}
	h1 {
		font-size: clamp(2.7rem, 7.4vw, 6rem);
	}
	.story {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
	}
	.story-grid {
		display: grid;
		gap: 3rem;
		align-items: start;
	}
	@media (min-width: 980px) {
		.story-grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			gap: 5rem;
		}
	}
	.big {
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		color: var(--ink);
	}
	.copy p {
		max-width: 34em;
		color: var(--muted);
	}
	.copy .big {
		color: var(--ink);
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 1.8rem;
	}
	.rules {
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 980px) {
		.rules > li:nth-child(2) {
			margin-left: 2.5rem;
		}
	}
	.rules article {
		display: flex;
		gap: 1.1rem;
		padding: 1.5rem;
		transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform 0.6s var(--ease);
	}
	.rules article:global(.tilting) {
		transition: transform 0.1s linear;
	}
	.ico {
		display: grid;
		place-items: center;
		flex: none;
		width: 3rem;
		height: 3rem;
		border-radius: 14px;
		background: color-mix(in srgb, var(--blue-strong) 16%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--blue) 30%, transparent);
		color: var(--blue);
	}
	.rules h2 {
		margin-bottom: 0.3rem;
		font-size: 1.25rem;
	}
	.rules p {
		margin: 0;
		color: var(--muted);
	}
	.team {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1.1rem;
	}
	.team article {
		height: 100%;
		padding: 1.6rem;
	}
	.role {
		margin: 0.2rem 0 0.8rem;
		font-size: 0.9rem;
		color: var(--cyan);
	}
</style>
