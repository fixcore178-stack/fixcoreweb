---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, WHATSAPP_URL, INSTAGRAM_URL, FACEBOOK_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="FixCore is a tech repair business in Trinidad & Tobago."
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>About FixCore</h1>
			<p>
				FixCore is a tech repair business based in Trinidad &amp; Tobago. We fix the devices you rely
				on every day, so you don't have to replace them.
			</p>
			<p>
				Not sure what's wrong, or whether it's worth repairing? Message us and describe the problem.
				We'll tell you what we can do and what it will cost before any work starts.
			</p>
			<p>
				Reach us on <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>,
				<a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a> or
				<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
