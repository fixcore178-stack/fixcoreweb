---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Circuit from '../components/Circuit.astro';
import {
	SITE_TITLE,
	SITE_TAGLINE,
	SITE_DESCRIPTION,
	WHATSAPP_NUMBER,
	WHATSAPP_DISPLAY,
	WHATSAPP_URL,
	INSTAGRAM_URL,
	INSTAGRAM_HANDLE,
	FACEBOOK_URL,
} from '../consts';

// Device `value` is the noun used in the WhatsApp message; `label` is the button text.
const devices = [
	{ label: 'Phone', value: 'phone', icon: 'phone' },
	{ label: 'Laptop', value: 'laptop', icon: 'laptop' },
	{ label: 'Tablet', value: 'tablet', icon: 'tablet' },
	{ label: 'Game console', value: 'game console', icon: 'console' },
	{ label: 'Something else', value: 'device', icon: 'other' },
] as const;

// Problem `value` finishes the sentence "my phone ...".
const problems = [
	{ label: 'Cracked screen', value: 'has a cracked screen', note: 'Cracked glass, black screen, lines or dead spots.' },
	{ label: 'Battery', value: 'has a battery problem', note: 'Drains fast, swollen, or shuts off by itself.' },
	{ label: "Won't charge", value: "won't charge", note: 'Not charging, or a loose or damaged charging port.' },
	{ label: 'Water damage', value: 'got wet', note: 'Dropped in water or spilled on. Switch it off and message us.' },
	{ label: "Won't turn on", value: "won't turn on", note: 'No power, stuck on the logo, or restarting.' },
	{ label: 'Slow or freezing', value: 'is slow or keeps freezing', note: 'Lag, crashes, full storage or software problems.' },
];

const steps = [
	{ title: "Tell us what's wrong", text: 'Use the picker at the top or write to us directly. Add the make and model, and a photo if you can.' },
	{ title: 'Get a quote', text: 'We reply on WhatsApp or Instagram with what it needs and what it costs.' },
	{ title: 'Get it fixed', text: 'Say yes to the quote and we get to work.' },
];

const faqs = [
	{
		q: 'How do I get a quote?',
		a: 'Pick what is wrong in the picker at the top and send the message on WhatsApp. You can also message us on Instagram. Tell us the make and model and we reply with a quote.',
	},
	{
		q: 'Can you fix my model?',
		a: 'Send us the make and model and what is wrong with it. If we cannot fix it, we will tell you.',
	},
	{
		q: 'What should I send with my message?',
		a: 'The make and model, what happened, and a photo of the damage if you can take one.',
	},
	{
		q: 'What is the fastest way to reach you?',
		a: `WhatsApp on ${WHATSAPP_DISPLAY}. You can also message ${INSTAGRAM_HANDLE} on Instagram or write on Facebook.`,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<Circuit />
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<h1>Phone buss? Laptop slow? We'll sort it out.</h1>
						<p class="lead">
							FixCore Tech repairs phones, laptops, tablets and game consoles right here in Trinidad
							&amp; Tobago. Tell us what's wrong on WhatsApp and we'll send you a quote.
						</p>
						<div class="actions">
							<a class="btn btn-wa" href={WHATSAPP_URL} target="_blank" rel="noopener">
								Message us on WhatsApp
							</a>
							<a class="btn btn-line" href={INSTAGRAM_URL} target="_blank" rel="noopener">
								Instagram
							</a>
						</div>
					</div>

					<form id="ticket" class="picker" data-number={WHATSAPP_NUMBER}>
						<h2 class="picker-title">Start your repair</h2>
						<fieldset>
							<legend>What is it?</legend>
							<div class="chips">
								{devices.map((d) => (
									<label class="chip">
										<input type="radio" name="device" value={d.value} />
										<span>{d.label}</span>
									</label>
								))}
							</div>
						</fieldset>
						<fieldset>
							<legend>What happened?</legend>
							<div class="chips">
								{problems.map((p) => (
									<label class="chip">
										<input type="radio" name="problem" value={p.value} />
										<span>{p.label}</span>
									</label>
								))}
							</div>
						</fieldset>
						<label class="details">
							<span>Anything else? (optional)</span>
							<input type="text" name="details" placeholder="Phone model, when it happened" autocomplete="off" />
						</label>
						<div class="preview">
							<span class="preview-label">Your message</span>
							<p id="message" aria-live="polite">{`Hi ${SITE_TITLE}, I need help with a repair.`}</p>
						</div>
						<a id="send" class="btn btn-wa send" href={WHATSAPP_URL} target="_blank" rel="noopener">
							Send on WhatsApp
						</a>
					</form>
				</div>
			</section>

			<section class="repairs" id="repairs">
				<div class="wrap">
					<h2>What we repair</h2>
					<p class="section-note">Not on the list? Drop us a message and ask. We'll tell you if we can help.</p>
					<div class="repair-cols">
						<div>
							<h3 class="col-title">Devices</h3>
							<ul class="rows devices">
								{devices.map((d) => (
									<li>
										<span class="ico"><Icon name={d.icon} /></span>
										<span class="row-title">{d.label === 'Something else' ? 'Other devices' : `${d.label}s`}</span>
									</li>
								))}
							</ul>
						</div>
						<div>
							<h3 class="col-title">Common problems</h3>
							<ul class="rows problems">
								{problems.map((p) => (
									<li>
										<span class="row-title">{p.label}</span>
										<span class="row-note">{p.note}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</section>

			<section class="how">
				<div class="wrap">
					<h2>How it works</h2>
					<ol class="steps">
						{steps.map((s) => (
							<li>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="faq" id="faq">
				<div class="wrap faq-grid">
					<h2>Questions</h2>
					<div class="qa">
						{faqs.map((f) => (
							<details>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))}
					</div>
				</div>
			</section>

			<section class="contact">
				<Circuit />
				<div class="wrap contact-in">
					<h2>Drop us a message</h2>
					<a class="number" href={WHATSAPP_URL} target="_blank" rel="noopener">
						<span class="sr-only">WhatsApp </span>{WHATSAPP_DISPLAY}
					</a>
					<div class="actions">
						<a class="btn btn-wa" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>
						<a class="btn btn-line" href={INSTAGRAM_URL} target="_blank" rel="noopener">
							Instagram {INSTAGRAM_HANDLE}
						</a>
						<a class="btn btn-line" href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const form = document.querySelector<HTMLFormElement>('#ticket');
			const out = document.querySelector<HTMLElement>('#message');
			const send = document.querySelector<HTMLAnchorElement>('#send');

			if (form && out && send) {
				const number = form.dataset.number ?? '';

				const build = () => {
					const data = new FormData(form);
					const device = String(data.get('device') ?? '');
					const problem = String(data.get('problem') ?? '');
					const details = String(data.get('details') ?? '').trim();

					let body = 'I need help with a repair.';
					if (device && problem) body = `my ${device} ${problem}.`;
					else if (device) body = `I need help with my ${device}.`;
					else if (problem) body = `my device ${problem}.`;

					let message = `Hi FixCore Tech, ${body}`;
					if (details) message += ` ${/[.!?]$/.test(details) ? details : details + '.'}`;
					if (device || problem) message += ' Can you give me a quote?';

					out.textContent = message;
					send.href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
				};

				form.addEventListener('input', build);
				form.addEventListener('submit', (e) => e.preventDefault());
			}
		</script>
	</body>
</html>

<style>
	/* Hero: logo navy with circuit traces, like the lines on the shield */
	.hero {
		position: relative;
		overflow: hidden;
		background: radial-gradient(120% 90% at 85% 0%, var(--navy-2) 0%, var(--navy) 60%);
		--circuit-node: var(--navy);
		color: #fff;
		padding-block: clamp(2.5rem, 6vw, 5rem);
	}
	/* Keep the traces quiet behind the text column and brighter on the right */
	.hero :global(.circuit) {
		mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 45%, #000 80%);
	}
	.hero-grid {
		position: relative;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	@media (min-width: 960px) {
		.hero-grid {
			grid-template-columns: 1.1fr 1fr;
			gap: 4rem;
		}
	}
	h1 {
		font-size: clamp(2.5rem, 6.2vw, 4.75rem);
		line-height: 1;
		letter-spacing: -0.045em;
		margin-bottom: 0.4em;
	}
	.lead {
		font-size: 1.25rem;
		line-height: 1.5;
		margin-bottom: 1.75rem;
		color: #cfe0f7;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	/* Picker card */
	.picker {
		background: var(--paper);
		color: var(--ink);
		border-radius: 18px;
		padding: clamp(1.25rem, 3vw, 2rem);
		box-shadow: 0 24px 60px rgb(0 8 30 / 0.5);
	}
	.picker-title {
		font-size: 1.6rem;
		margin-bottom: 1.25rem;
	}
	fieldset {
		border: 0;
		margin: 0 0 1.25rem;
		padding: 0;
		min-width: 0;
	}
	legend {
		padding: 0;
		margin-bottom: 0.6rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		position: relative;
	}
	.chip input {
		position: absolute;
		inset: 0;
		opacity: 0;
		margin: 0;
		cursor: pointer;
	}
	.chip span {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: 1rem;
		border: 1.5px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1;
		transition: border-color 0.15s, background-color 0.15s, color 0.15s;
	}
	.chip input:hover + span {
		border-color: var(--blue);
		color: var(--blue);
	}
	.chip input:checked + span {
		background: var(--blue);
		border-color: var(--blue);
		color: #fff;
	}
	.chip input:focus-visible + span {
		outline: 3px solid var(--blue);
		outline-offset: 2px;
	}
	.details {
		display: block;
		margin-bottom: 1.25rem;
	}
	.details span {
		display: block;
		margin-bottom: 0.4rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.details input {
		width: 100%;
		min-height: 3rem;
		padding: 0 0.9rem;
		border: 1.5px solid var(--line);
		border-radius: 10px;
		background: var(--paper);
		font: inherit;
		color: var(--ink);
		transition: border-color 0.15s;
	}
	.details input::placeholder {
		color: #6b7691;
	}
	.details input:hover {
		border-color: #9aa7c7;
	}
	.details input:focus {
		outline: none;
		border-color: var(--blue);
		box-shadow: 0 0 0 3px rgb(31 79 255 / 0.2);
	}
	.preview {
		margin-bottom: 1.25rem;
		padding: 1rem 1.1rem;
		border-radius: 12px;
		background: var(--mist);
	}
	.preview-label {
		display: block;
		margin-bottom: 0.25rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted);
	}
	.preview p {
		margin: 0;
		min-height: 3.2em;
	}
	.send {
		width: 100%;
		min-height: 3.5rem;
		font-size: 1.1rem;
	}

	/* Sections */
	section:not(.hero) {
		padding-block: clamp(3.5rem, 8vw, 6rem);
	}
	.section-note {
		margin: 0.75rem 0 2.5rem;
		font-size: 1.15rem;
		color: var(--muted);
	}

	/* Repairs */
	.repair-cols {
		display: grid;
		gap: 2.5rem 4rem;
	}
	@media (min-width: 900px) {
		.repair-cols {
			grid-template-columns: 1fr 1.25fr;
		}
	}
	.col-title {
		margin-bottom: 0.75rem;
		font-size: 1rem;
		color: var(--blue);
		letter-spacing: 0;
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 2px solid var(--ink);
	}
	.rows li {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block: 1.1rem;
		border-bottom: 1px solid var(--line);
	}
	.ico {
		display: grid;
		place-items: center;
		flex: none;
		width: 3rem;
		height: 3rem;
		border-radius: 12px;
		background: var(--mist);
		color: var(--blue);
	}
	.row-title {
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.35rem;
		letter-spacing: -0.03em;
	}
	.problems li {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.15rem;
		align-items: start;
	}
	@media (min-width: 640px) {
		.problems li {
			grid-template-columns: 11rem 1fr;
			gap: 1.5rem;
		}
	}
	.row-note {
		color: var(--muted);
	}

	/* How it works */
	.how {
		background: var(--mist);
	}
	.how h2 {
		margin-bottom: 2.5rem;
	}
	.steps {
		counter-reset: step;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 800px) {
		.steps {
			grid-template-columns: repeat(3, 1fr);
			gap: 2.5rem;
		}
	}
	.steps li {
		counter-increment: step;
	}
	/* Shield-shaped badge, borrowed from the logo */
	.steps li::before {
		content: counter(step);
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 4rem;
		margin-bottom: 1rem;
		padding-bottom: 0.35rem;
		clip-path: polygon(50% 0, 100% 12%, 100% 58%, 50% 100%, 0 58%, 0 12%);
		background: var(--blue);
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.6rem;
		line-height: 1;
		color: #fff;
	}
	.steps h3 {
		margin-bottom: 0.5rem;
		font-size: 1.4rem;
	}
	.steps p {
		margin: 0;
		color: var(--muted);
	}

	/* FAQ */
	.faq-grid {
		display: grid;
		gap: 2rem 4rem;
	}
	@media (min-width: 900px) {
		.faq-grid {
			grid-template-columns: 1fr 1.6fr;
			align-items: start;
		}
	}
	.qa {
		border-top: 2px solid var(--ink);
	}
	details {
		border-bottom: 1px solid var(--line);
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.2rem;
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		cursor: pointer;
		list-style: none;
		transition: color 0.15s;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: '+';
		flex: none;
		font-size: 1.6rem;
		line-height: 1;
		color: var(--blue);
	}
	details[open] summary::after {
		content: '\2212';
	}
	summary:hover {
		color: var(--blue);
	}
	details p {
		margin: 0 0 1.25rem;
		color: var(--muted);
	}

	/* Contact */
	.contact {
		position: relative;
		overflow: hidden;
		background: var(--navy);
		--circuit-node: var(--navy);
		color: #fff;
	}
	.contact-in {
		position: relative;
	}
	.contact h2 {
		color: #fff;
	}
	.number {
		display: block;
		margin: 0.5rem 0 2rem;
		width: fit-content;
		max-width: 100%;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2.75rem, 12vw, 8.5rem);
		line-height: 1;
		letter-spacing: -0.05em;
		white-space: nowrap;
		color: #fff;
		text-decoration: none;
		transition: color 0.15s;
	}
	.number:hover {
		color: var(--blue-glow);
	}
	.contact :global(.btn-line):hover {
		background: rgb(255 255 255 / 0.12);
	}
</style>
