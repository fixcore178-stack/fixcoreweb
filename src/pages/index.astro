---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_TITLE,
	SITE_TAGLINE,
	SITE_DESCRIPTION,
	WHATSAPP_URL,
	WHATSAPP_DISPLAY,
	INSTAGRAM_URL,
	INSTAGRAM_HANDLE,
	FACEBOOK_URL,
} from '../consts';

// Examples of what people can ask about. Edit freely once the service list is settled.
const devices = [
	{ name: 'Phones & tablets', note: 'Cracked screens, battery, charging problems, water damage.' },
	{ name: 'Laptops & computers', note: 'Slow, won\'t start, overheating, broken screens or keyboards.' },
	{ name: 'Other devices', note: 'Game consoles, accessories and more. If it\'s tech, ask us.' },
];

const steps = [
	{ title: 'Message us', text: 'Tell us what\'s wrong with your device on WhatsApp or Instagram. Photos help.' },
	{ title: 'Get a quote', text: 'We get back to you with what\'s needed and what it will cost.' },
	{ title: 'Get it fixed', text: 'Once you\'re happy with the quote, we fix it and let you know when it\'s ready.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Tech repairs · Trinidad &amp; Tobago</p>
				<h1>Broken tech? <span>We'll fix it.</span></h1>
				<p class="lead">
					FixCore repairs your devices so you can get back to what matters. Tell us what's wrong and
					we'll get back to you with a quote.
				</p>
				<div class="buttons">
					<a class="btn whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener">
						Message us on WhatsApp
					</a>
					<a class="btn ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">
						{INSTAGRAM_HANDLE} on Instagram
					</a>
				</div>
			</section>

			<section>
				<h2>What we repair</h2>
				<p>Not sure if we can fix yours? Send us a message and ask.</p>
				<div class="cards">
					{devices.map((d) => (
						<div class="card">
							<h3>{d.name}</h3>
							<p>{d.note}</p>
						</div>
					))}
				</div>
			</section>

			<section>
				<h2>How it works</h2>
				<ol class="steps">
					{steps.map((s, i) => (
						<li>
							<span class="num">{i + 1}</span>
							<div>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="contact" id="contact">
				<h2>Get in touch</h2>
				<p>The fastest way to reach us is WhatsApp.</p>
				<div class="buttons">
					<a class="btn whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener">
						WhatsApp {WHATSAPP_DISPLAY}
					</a>
					<a class="btn ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
					<a class="btn ghost" href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 1000px;
		max-width: 100%;
		padding: 2em 1em 3em;
	}
	section {
		margin-bottom: 3.5em;
	}
	.hero {
		padding: 2.5em 1.5em;
		border-radius: 16px;
		background: linear-gradient(135deg, #0b1630, #12307a);
		color: #e8eeff;
	}
	.hero h1 {
		color: white;
		font-size: 2.6em;
		margin-bottom: 0.4em;
	}
	.hero h1 span {
		color: #6fd3ff;
	}
	.eyebrow {
		margin: 0 0 0.5em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.75em;
		color: #9fb4ff;
	}
	.lead {
		font-size: 1.1em;
		max-width: 36em;
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
		margin-top: 1.25em;
	}
	.btn {
		display: inline-block;
		padding: 0.6em 1.2em;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		font-size: 0.95em;
	}
	.btn.whatsapp {
		background: #25d366;
		color: #06311a;
	}
	.btn.ghost {
		border: 2px solid currentColor;
		color: var(--accent);
	}
	.hero .btn.ghost {
		color: white;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1em;
		margin-top: 1.25em;
	}
	.card {
		padding: 1.25em;
		border-radius: 12px;
		background: white;
		box-shadow: 0 2px 10px rgba(var(--gray), 25%);
	}
	.card h3 {
		font-size: 1.2em;
		margin-bottom: 0.3em;
	}
	.card p {
		margin: 0;
		font-size: 0.9em;
	}
	.steps {
		list-style: none;
		padding: 0;
		margin: 1.25em 0 0;
		display: grid;
		gap: 1em;
	}
	.steps li {
		display: flex;
		gap: 1em;
		align-items: flex-start;
	}
	.steps h3 {
		font-size: 1.2em;
		margin-bottom: 0.1em;
	}
	.steps p {
		margin: 0;
	}
	.num {
		flex: none;
		width: 2.2em;
		height: 2.2em;
		border-radius: 50%;
		background: var(--accent);
		color: white;
		font-weight: 700;
		display: grid;
		place-items: center;
	}
	.contact {
		padding: 2em 1.5em;
		border-radius: 16px;
		background: rgb(var(--gray-light));
		text-align: center;
	}
	.contact .buttons {
		justify-content: center;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2em;
		}
	}
</style>
