---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_TITLE,
	SITE_TAGLINE,
	SITE_DESCRIPTION,
	WHATSAPP_NUMBER,
	WHATSAPP_DISPLAY,
	WHATSAPP_URL,
	INSTAGRAM_URL,
	INSTAGRAM_HANDLE,
	FACEBOOK_URL,
} from '../consts';

// `value` is the noun used in the message; `label` is what the button says.
const devices = [
	{ label: 'Phone', value: 'phone' },
	{ label: 'Laptop', value: 'laptop' },
	{ label: 'Tablet', value: 'tablet' },
	{ label: 'Game console', value: 'game console' },
	{ label: 'Something else', value: 'device' },
];

// `value` finishes the sentence "my phone ...".
const problems = [
	{ label: 'Cracked screen', value: 'has a cracked screen' },
	{ label: "Won't charge", value: "won't charge" },
	{ label: 'Water damage', value: 'got wet' },
	{ label: "Won't turn on", value: "won't turn on" },
	{ label: 'Slow or freezing', value: 'is slow or keeps freezing' },
	{ label: 'Something else', value: 'has a different problem' },
];

const steps = [
	{ title: "Tell us what's wrong", text: 'Use the picker above or just write to us. Photos help.' },
	{ title: 'Get a quote', text: 'We reply on WhatsApp or Instagram with what it needs and the price.' },
	{ title: 'Get it fixed', text: 'Say yes to the quote and we get to work.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<form id="ticket" class="wrap grid" data-number={WHATSAPP_NUMBER}>
					<h1 class="rise" style="--i:0">What's broken?</h1>
					<p class="intro rise" style="--i:1">
						Pick what's wrong and we'll write the message for you. Send it on WhatsApp and we'll
						reply with a quote.
					</p>

					<div class="choices rise" style="--i:2">
						<fieldset>
							<legend>What is it?</legend>
							<div class="chips">
								{devices.map((d) => (
									<label class="chip">
										<input type="radio" name="device" value={d.value} />
										<span>{d.label}</span>
									</label>
								))}
							</div>
						</fieldset>
						<fieldset>
							<legend>What happened?</legend>
							<div class="chips">
								{problems.map((p) => (
									<label class="chip">
										<input type="radio" name="problem" value={p.value} />
										<span>{p.label}</span>
									</label>
								))}
							</div>
						</fieldset>
					</div>

					<div class="tag rise" style="--i:3">
						<h2 class="tag-title">Your message</h2>
						<p id="message" class="message" aria-live="polite">{`Hi ${SITE_TITLE}, I need help with a repair.`}</p>
						<label class="details">
							<span>Anything else we should know?</span>
							<input type="text" name="details" placeholder="Phone model, when it happened" autocomplete="off" />
						</label>
						<a id="send" class="send" href={WHATSAPP_URL} target="_blank" rel="noopener">
							Send on WhatsApp
						</a>
					</div>
				</form>
			</section>

			<section class="band">
				<div class="wrap">
					<h2>How a repair works</h2>
					<ol class="steps">
						{steps.map((s) => (
							<li>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="contact">
				<div class="wrap">
					<p class="ask">Would you rather talk it through?</p>
					<a class="number" href={WHATSAPP_URL} target="_blank" rel="noopener">
						<span class="sr-only">WhatsApp </span>{WHATSAPP_DISPLAY}
					</a>
					<p class="socials">
						<a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram {INSTAGRAM_HANDLE}</a>
						<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const form = document.querySelector<HTMLFormElement>('#ticket');
			const out = document.querySelector<HTMLElement>('#message');
			const send = document.querySelector<HTMLAnchorElement>('#send');

			if (form && out && send) {
				const number = form.dataset.number ?? '';

				const build = () => {
					const data = new FormData(form);
					const device = String(data.get('device') ?? '');
					const problem = String(data.get('problem') ?? '');
					const details = String(data.get('details') ?? '').trim();

					let body = 'I need help with a repair.';
					if (device && problem) body = `my ${device} ${problem}.`;
					else if (device) body = `I need help with my ${device}.`;
					else if (problem) body = `my device ${problem}.`;

					let message = `Hi FixCore, ${body}`;
					if (details) message += ` ${/[.!?]$/.test(details) ? details : details + '.'}`;
					if (device || problem) message += ' Can you give me a quote?';

					out.textContent = message;
					send.href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
				};

				form.addEventListener('input', build);
				form.addEventListener('submit', (e) => e.preventDefault());
			}
		</script>
	</body>
</html>

<style>
	/* The one orchestrated moment: the hero assembles in sequence on load. */
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
	.rise {
		animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: calc(var(--i) * 110ms);
	}

	/* Hero: headline and controls on the left, the message tag hangs off the right */
	.hero {
		padding-block: clamp(2rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
	}
	.grid {
		display: grid;
		gap: 0 2rem;
		grid-template-columns: 1fr;
	}
	h1 {
		font-size: clamp(2.5rem, 13vw, 7rem);
		margin-bottom: 0.3em;
	}
	.intro {
		font-size: 1.2rem;
		color: var(--muted);
		margin-bottom: 2.25rem;
	}
	@media (min-width: 900px) {
		.grid {
			grid-template-columns: repeat(12, 1fr);
		}
		h1 {
			grid-column: 1 / -1;
			grid-row: 1;
			font-size: clamp(3rem, 9.5vw, 7rem);
		}
		.intro {
			grid-column: 1 / span 6;
			grid-row: 2;
		}
		.choices {
			grid-column: 1 / span 7;
			grid-row: 3;
		}
		/* Pulled up under the headline and tilted, so it sits off the grid like a hung tag */
		.tag {
			grid-column: 8 / -1;
			grid-row: 2 / span 2;
			align-self: start;
			margin-top: -1.25rem;
			transform: rotate(1.6deg);
		}
	}
	/* Keep the final resting angle when the entrance finishes */
	@media (min-width: 900px) {
		@keyframes rise-tilted {
			from {
				opacity: 0;
				transform: translateY(18px) rotate(1.6deg);
			}
		}
		.tag.rise {
			animation-name: rise-tilted;
		}
	}

	fieldset {
		border: 0;
		margin: 0 0 1.75rem;
		padding: 0;
		min-width: 0;
	}
	legend {
		padding: 0;
		margin-bottom: 0.75rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--muted);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		position: relative;
	}
	.chip input {
		position: absolute;
		inset: 0;
		opacity: 0;
		margin: 0;
		cursor: pointer;
	}
	.chip span {
		display: inline-flex;
		align-items: center;
		min-height: 2.9rem;
		padding-inline: 1.1rem;
		border: 1px solid var(--border-strong);
		border-radius: 2px;
		background: var(--surface);
		font-weight: 600;
		font-size: 1rem;
		line-height: 1;
		transition: border-color 0.15s, color 0.15s, background-color 0.15s;
	}
	.chip input:hover + span {
		border-color: var(--accent);
		color: var(--accent);
	}
	.chip input:checked + span {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}
	.chip input:focus-visible + span {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* The message, shaped like the tag that goes on a device at the bench */
	.tag {
		position: relative;
		background: var(--surface);
		border: 1px solid var(--border-strong);
		border-radius: 3px;
		padding: 3rem 1.5rem 1.5rem;
	}
	.tag::before {
		content: '';
		position: absolute;
		top: 1.1rem;
		left: 1.5rem;
		width: 0.9rem;
		height: 0.9rem;
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		background: var(--bg);
	}
	.tag-title {
		font-size: 1.3rem;
		letter-spacing: -0.02em;
		margin-bottom: 0.75rem;
	}
	.message {
		min-height: 6.5em;
		margin-bottom: 1.25rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px dashed var(--border-strong);
		font-size: 1.15rem;
		line-height: 1.5;
	}
	.details {
		display: block;
		margin-bottom: 1.5rem;
	}
	.details span {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.details input {
		width: 100%;
		min-height: 2.9rem;
		padding: 0;
		border: 0;
		border-bottom: 1px solid var(--border-strong);
		border-radius: 0;
		background: transparent;
		font: inherit;
		color: var(--text);
		transition: border-color 0.15s;
	}
	.details input::placeholder {
		color: var(--muted);
		opacity: 0.7;
	}
	.details input:hover {
		border-bottom-color: var(--text);
	}
	.details input:focus {
		outline: none;
		border-bottom-color: var(--accent);
		box-shadow: 0 1px 0 var(--accent);
	}
	.send {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 3.5rem;
		border-radius: 2px;
		background: var(--accent);
		color: var(--accent-ink);
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		transition: transform 0.12s, background-color 0.15s;
	}
	.send:hover {
		background: #ffc94d;
		color: var(--accent-ink);
		transform: translateY(-2px);
	}
	.send:active {
		transform: translateY(0);
	}

	/* How it works: a real sequence, so the steps stair-step across the page */
	.band {
		background: var(--surface);
		border-block: 1px solid var(--border);
		padding-block: clamp(3.5rem, 9vw, 6.5rem);
	}
	.band h2 {
		margin-bottom: 2.5rem;
		max-width: 8em;
	}
	.steps {
		counter-reset: step;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}
	.steps li {
		counter-increment: step;
		display: grid;
		grid-template-columns: 4.25rem 1fr;
		column-gap: 1rem;
		padding-block: 1.5rem;
		border-top: 1px solid var(--border);
		max-width: 36rem;
	}
	.steps li::before {
		content: counter(step);
		grid-row: span 2;
		font-family: var(--display);
		font-weight: 800;
		font-size: 3.25rem;
		line-height: 0.85;
		letter-spacing: -0.04em;
		color: var(--accent);
	}
	.steps h3 {
		margin-bottom: 0.4rem;
	}
	.steps p {
		margin: 0;
		color: var(--muted);
	}
	@media (min-width: 900px) {
		.steps li:nth-child(2) {
			margin-left: 18%;
		}
		.steps li:nth-child(3) {
			margin-left: 36%;
		}
	}

	/* Contact */
	.contact {
		padding-block: clamp(4rem, 9vw, 7rem);
	}
	.ask {
		margin-bottom: 0.25rem;
		font-size: 1.15rem;
		color: var(--muted);
	}
	.number {
		display: inline-block;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2.25rem, 11.5vw, 9rem);
		line-height: 1;
		letter-spacing: -0.05em;
		white-space: nowrap;
		text-decoration: none;
		background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 100% 0.07em;
		transition: background-size 0.2s, color 0.15s;
	}
	.number:hover {
		background-size: 100% 100%;
		color: var(--accent-ink);
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
		margin: 1.25rem 0 0;
		max-width: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
