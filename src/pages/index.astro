---
import Base from '../layouts/Base.astro';
import DeviceScene from '../components/DeviceScene.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Faq from '../components/Faq.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import {
	SITE_TITLE,
	SITE_TAGLINE,
	SITE_DESCRIPTION,
	SITE_URL,
	WHATSAPP_URL,
	WHATSAPP_DISPLAY,
	INSTAGRAM_URL,
	FACEBOOK_URL,
	TIKTOK_URL,
	socials,
} from '../consts';
import { services, quoteHref } from '../data/services';
import { business, policies } from '../data/site';

const trust = [
	{ icon: 'pin', text: `Local to ${business.serviceArea}` },
	{ icon: 'chat', text: 'Quotes on WhatsApp' },
	{ icon: 'quote', text: 'A quote before any work' },
	{ icon: 'wrench', text: 'Phones and laptops, all brands' },
] as const;

const steps = [
	{ icon: 'chat', title: "Tell us what's wrong", text: 'Use the quote form or message us directly. Add the make and model, and a photo if you can.' },
	{ icon: 'quote', title: 'Get a quote', text: 'We reply on WhatsApp or Instagram with what it needs and what it costs.' },
	{ icon: 'wrench', title: 'Get it fixed', text: 'Say yes to the quote and we get to work. If we cannot fix it, we will tell you.' },
] as const;

const why = [
	{ icon: 'pin', title: 'Local and easy to reach', text: `A ${business.serviceArea} business you can message directly on WhatsApp, Instagram, TikTok or Facebook.` },
	{ icon: 'quote', title: 'A quote before any work', text: 'You hear what it needs and what it costs first. Work starts when you say yes.' },
	{ icon: 'shield', title: 'Straight answers', text: 'If it is not worth repairing, or we cannot fix it, we will tell you plainly.' },
	{ icon: 'wrench', title: 'Repair, do not replace', text: 'Fixing the device you already own is often the better choice. Ask us and we will tell you.' },
] as const;

const faqs = [
	{ q: 'How do I get a quote?', a: 'Use the quote form on this page. Pick your device and the problem, add a few details and send the ready-made message on WhatsApp. You can also message us directly on WhatsApp or Instagram. We reply with what it needs and the price.' },
	{ q: 'Which devices do you repair?', a: 'Phones and laptops, all brands. If your device is something else, message us and ask.' },
	{ q: 'Can you fix my model?', a: 'Send us the make and model and what is wrong with it. If we cannot fix it, we will tell you.' },
	{ q: 'What should I send with my message?', a: 'The make and model, what happened and when it started. A photo of any damage helps a lot.' },
	{ q: 'My device got wet. What should I do?', a: 'Switch it off straight away, do not try to charge it and message us. Acting quickly gives it the best chance.' },
	{ q: 'Do I need to message first?', a: 'Yes. Message us on WhatsApp with your device and the problem. We confirm the price and whether it needs drop-off before you bring it in.' },
	{ q: 'Do you offer delivery?', a: `${policies.coverage}` },
	{ q: 'Do you need a deposit?', a: `${policies.deposit}` },
	{ q: 'How long do you keep my device?', a: `${policies.storage}` },
	{ q: 'How long does a repair take?', a: `${policies.repairTime}` },
	{ q: 'Can you recover my data?', a: `${policies.dataRecovery} We recommend backing up anything important first.` },
	{ q: 'How do I pay?', a: `${policies.payment}` },
	{ q: 'Do I have to leave my device with you?', a: `${policies.dropOff}` },
	{ q: 'What is the fastest way to reach you?', a: `WhatsApp on ${WHATSAPP_DISPLAY}. You can also message us on Instagram, TikTok or Facebook.` },
	...(business.warranty ? [{ q: 'Do you offer a warranty?', a: business.warranty }] : []),
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: SITE_URL,
	image: `${SITE_URL}/og.png`,
	telephone: '+18687200146',
	areaServed: { '@type': 'Country', name: 'Trinidad and Tobago' },
	sameAs: [INSTAGRAM_URL, FACEBOOK_URL, TIKTOK_URL],
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Repair services',
		itemListElement: services.map((s) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: s.name, url: `${SITE_URL}/services/${s.slug}` },
		})),
	},
};

// Bento layout: widths for the first five service cards
const spans = ['s7', 's5', 's4', 's4', 's4'];
---

<Base title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} schema={schema}>
	<!-- ============ Hero ============ -->
	<section class="hero" id="top">
		<div class="wrap hero-grid">
			<div class="copy">
				<span class="eyebrow reveal">Local tech repair · {business.serviceArea}</span>
				<h1 class="reveal-lines">
					<span class="line" style="--i:0"><span>Phone buss?</span></span>
					<span class="line" style="--i:1"><span>Laptop slow?</span></span>
					<span class="line" style="--i:2"><span class="grad">We'll sort it out.</span></span>
				</h1>
				<p class="lead reveal" style="--d:3">
					{SITE_TITLE} repairs phones and laptops, all brands, across Trinidad and Tobago. Tell us what is wrong
					and we will send you a quote on WhatsApp.
				</p>
				<div class="cta-row reveal" style="--d:4">
					<a class="btn btn-primary btn-lg" href="#quote">
						Get a repair quote <Icon class="arrow" name="arrow" size={18} stroke={2.2} />
					</a>
					<a class="btn btn-glass btn-lg" href={WHATSAPP_URL} target="_blank" rel="noopener">
						<BrandIcon name="whatsapp" size={19} /> WhatsApp us
					</a>
				</div>
				<div class="follow reveal" style="--d:5">
					<span>Find us on</span>
					<ul>
						{
							socials.slice(1).map((s) => (
								<li>
									<a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label} ${s.handle}`}>
										<BrandIcon name={s.name} size={18} />
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class="visual reveal" style="--d:2">
				<DeviceScene />
			</div>
		</div>

		<div class="wrap">
			<ul class="trust glass reveal" style="--d:6">
				{
					trust.map((t) => (
						<li>
							<Icon name={t.icon} size={20} />
							<span>{t.text}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============ Services ============ -->
	<section class="section" id="services">
		<div class="wrap">
			<div class="section-head head-split">
				<div class="reveal">
					<span class="eyebrow">Repairs</span>
					<h2>Whatever is broken, <span class="grad">start here</span>.</h2>
				</div>
				<p class="lead reveal" style="--d:1">
					Pick the device to see what we fix. Not on the list? Message us and ask. We will tell you if we can help.
				</p>
			</div>

			<ul class="bento">
				{
					services.map((s, i) => (
						<li class={`reveal ${spans[i] ?? ''}`} style={`--d:${i % 3}`}>
							<a class="svc glass glow" data-tilt="4" href={`/services/${s.slug}`}>
								<span class="svc-ico"><Icon name={s.icon} size={28} /></span>
								<h3>{s.cardTitle}</h3>
								<p>{s.cardText}</p>
								<ul class="chips" aria-label="Common fixes">
									{s.problems.slice(0, 3).map((p) => (
										<li>{p.title}</li>
									))}
								</ul>
								<span class="more">
									Explore <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
								</span>
							</a>
						</li>
					))
				}
				<li class="reveal s12" style="--d:1">
					<a class="svc svc-wide glass glow" data-tilt="2" href="/?device=other#quote">
						<span class="svc-ico"><Icon name="other" size={28} /></span>
						<div class="wide-copy">
							<h3>Something else?</h3>
							<p>Smartwatches, e-readers and other gadgets. Tell us what it is and we will let you know if we can help.</p>
						</div>
						<span class="more">
							Ask us <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
						</span>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<!-- ============ Quote ============ -->
	<section class="section" id="quote" data-hide-fab>
		<div class="wrap quote-grid">
			<div class="quote-intro">
				<div class="reveal">
					<span class="eyebrow">Repair quote</span>
					<h2>Your message, <span class="grad">written for you</span>.</h2>
					<p class="lead">Pick the device, tell us the problem, review it and send it on WhatsApp. No account needed.</p>
				</div>
				<ul class="how-mini reveal" style="--d:1">
					<li><span class="n">1</span><span>Choose your device and what is going on</span></li>
					<li><span class="n">2</span><span>Add the model and any details</span></li>
					<li><span class="n">3</span><span>Review and send it on WhatsApp</span></li>
				</ul>
				<p class="alt reveal" style="--d:2">
					Prefer to type it yourself?
					<a href={WHATSAPP_URL} target="_blank" rel="noopener">Message us on WhatsApp</a>.
				</p>
			</div>
			<div class="reveal" style="--d:1">
				<QuoteWizard />
			</div>
		</div>
	</section>

	<!-- ============ How it works ============ -->
	<section class="section" id="process">
		<div class="wrap">
			<div class="section-head reveal">
				<span class="eyebrow">How it works</span>
				<h2>Three steps, <span class="grad">no guesswork</span>.</h2>
			</div>
			<ol class="timeline" data-progress style="--p:0">
				{
					steps.map((s, i) => (
						<li data-step>
							<span class="node">
								<Icon name={s.icon} size={22} />
								<b>{i + 1}</b>
							</span>
							<div class="step-card glass reveal" style={`--d:${i}`}>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============ Why FixCore ============ -->
	<section class="section" id="why">
		<div class="wrap why-grid">
			<div class="why-copy reveal">
				<span class="eyebrow">Why {SITE_TITLE}</span>
				<h2>Repairs that feel <span class="grad">straightforward</span>.</h2>
				<p class="lead">No jargon and no runaround. Just a local team that tells you what is going on.</p>
			</div>
			<ul class="why-list">
				{
					why.map((w, i) => (
						<li class="reveal" style={`--d:${i}`}>
							<article class="glass glow" data-tilt="3">
								<span class="svc-ico"><Icon name={w.icon} size={24} /></span>
								<h3>{w.title}</h3>
								<p>{w.text}</p>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<Gallery />
	<Testimonials />

	<ContactSection />

	<!-- ============ FAQ ============ -->
	<section class="section" id="faq">
		<div class="wrap faq-grid">
			<div class="faq-copy reveal">
				<span class="eyebrow">FAQ</span>
				<h2>Good <span class="grad">questions</span>.</h2>
				<p class="lead">Cannot find your answer? Message us and we will get back to you.</p>
				<a class="btn btn-glass" href={WHATSAPP_URL} target="_blank" rel="noopener">
					<BrandIcon name="whatsapp" size={18} /> Ask on WhatsApp
				</a>
			</div>
			<Faq items={faqs} />
		</div>
	</section>

	<CtaBand />
</Base>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		padding: clamp(7.5rem, 14vw, 10rem) 0 clamp(2rem, 5vw, 3.5rem);
	}
	.hero-grid {
		display: grid;
		gap: 3rem;
		align-items: center;
	}
	@media (min-width: 980px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
			gap: 2rem;
		}
	}
	h1 {
		margin-bottom: 1.4rem;
		font-size: clamp(2.7rem, 7.2vw, 5.6rem);
	}
	@media (min-width: 980px) {
		/* Each phrase stays on its own line beside the device scene */
		h1 {
			font-size: clamp(2.6rem, 4.75vw, 4.5rem);
		}
		h1 .line > span {
			white-space: nowrap;
		}
	}
	.hero .lead {
		max-width: 31em;
		margin-bottom: 2rem;
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}
	.follow {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.follow ul {
		display: flex;
		gap: 0.5rem;
	}
	.follow a {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		color: var(--ink);
		transition:
			transform 0.35s var(--ease),
			background-color 0.2s,
			color 0.2s;
	}
	.follow a:hover {
		transform: translateY(-3px);
		background: var(--glass-hi);
		color: var(--cyan);
	}
	.visual {
		position: relative;
	}
	@media (min-width: 980px) {
		.visual {
			margin-right: -1.5rem;
		}
	}
	.trust {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.5rem 1.5rem;
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding: 1.1rem 1.6rem;
		--r: 20px;
	}
	.trust li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--ink-2);
	}
	.trust :global(svg) {
		flex: none;
		color: var(--cyan);
	}

	/* ---------- Services bento ---------- */
	.head-split {
		display: grid;
		gap: 1rem 3rem;
		align-items: end;
	}
	@media (min-width: 900px) {
		.head-split {
			grid-template-columns: 1.2fr 1fr;
		}
		.head-split .lead {
			margin: 0 0 0.35rem;
		}
	}
	.bento {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 680px) {
		.bento {
			grid-template-columns: repeat(2, 1fr);
		}
		.bento .s12 {
			grid-column: 1 / -1;
		}
	}
	@media (min-width: 1000px) {
		.bento {
			grid-template-columns: repeat(12, 1fr);
		}
		.bento .s7 {
			grid-column: span 7;
		}
		.bento .s5 {
			grid-column: span 5;
		}
		.bento .s4 {
			grid-column: span 4;
		}
		.bento .s12 {
			grid-column: span 12;
		}
	}
	.bento > li {
		display: flex;
	}
	.svc {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		width: 100%;
		padding: clamp(1.4rem, 2.5vw, 1.9rem);
		color: var(--ink);
		text-decoration: none;
		transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition:
			transform 0.6s var(--ease),
			background-color 0.3s;
	}
	.svc.tilting {
		transition:
			transform 0.1s linear,
			background-color 0.3s;
	}
	.svc:hover {
		color: var(--ink);
		background: var(--glass-hi);
	}
	.svc-ico {
		display: grid;
		place-items: center;
		width: 3.4rem;
		height: 3.4rem;
		margin-bottom: 1.1rem;
		border-radius: 16px;
		background: color-mix(in srgb, var(--blue-strong) 16%, transparent);
		box-shadow:
			inset 0 0 0 1px color-mix(in srgb, var(--blue) 30%, transparent),
			0 8px 24px color-mix(in srgb, var(--blue-strong) 18%, transparent);
		color: var(--blue);
		transition:
			background 0.35s,
			color 0.35s,
			transform 0.5s var(--ease);
	}
	.svc:hover .svc-ico,
	.why-list article:hover .svc-ico {
		background: var(--accent-grad);
		color: var(--on-accent);
		transform: translateY(-3px) rotate(-5deg);
	}
	.svc h3 {
		font-size: clamp(1.3rem, 2.2vw, 1.6rem);
		margin-bottom: 0.5rem;
	}
	.svc p {
		margin: 0 0 1.1rem;
		color: var(--muted);
		max-width: 30em;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.4rem;
	}
	.chips li {
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		font-size: 0.8rem;
		color: var(--ink-2);
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: auto;
		font-family: var(--display);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--blue);
	}
	.more :global(svg) {
		transition: transform 0.4s var(--ease);
	}
	.svc:hover .more {
		color: var(--cyan);
	}
	.svc:hover .more :global(svg) {
		transform: translateX(6px);
	}
	.svc-wide {
		flex-direction: row;
		align-items: center;
		gap: 1.4rem;
	}
	.svc-wide .svc-ico {
		margin: 0;
		flex: none;
	}
	.svc-wide p {
		margin: 0;
	}
	.svc-wide h3 {
		margin-bottom: 0.2rem;
	}
	.svc-wide .more {
		margin: 0 0 0 auto;
	}
	@media (max-width: 679px) {
		.svc-wide {
			flex-direction: column;
			align-items: flex-start;
		}
		.svc-wide .svc-ico {
			margin-bottom: 0.4rem;
		}
		.svc-wide .more {
			margin: 1rem 0 0;
		}
	}

	/* ---------- Quote ---------- */
	.quote-grid {
		display: grid;
		gap: 2.5rem;
		align-items: start;
	}
	@media (min-width: 1000px) {
		.quote-grid {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr);
			gap: 4rem;
		}
		.quote-intro {
			position: sticky;
			top: 7rem;
		}
	}
	.quote-intro h2,
	.why-copy h2,
	.faq-copy h2 {
		font-size: clamp(1.9rem, 3.5vw, 2.9rem);
		overflow-wrap: normal;
		hyphens: none;
	}
	.how-mini {
		display: grid;
		gap: 0.9rem;
		margin: 2rem 0 1.5rem;
	}
	.how-mini li {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: var(--ink-2);
	}
	.how-mini .n {
		display: grid;
		place-items: center;
		flex: none;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke-hi);
		font-family: var(--display);
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--cyan);
	}
	.alt {
		font-size: 0.95rem;
		color: var(--muted);
	}

	/* ---------- Timeline ---------- */
	.timeline {
		position: relative;
		display: grid;
		gap: 1.5rem;
		align-items: start;
	}
	/* Track and glowing fill. Vertical on small screens, horizontal on wide ones. */
	.timeline::before,
	.timeline::after {
		content: '';
		position: absolute;
		left: 1.6rem;
		top: 1.6rem;
		bottom: 1.6rem;
		width: 2px;
		border-radius: 2px;
	}
	.timeline::before {
		background: var(--stroke);
	}
	.timeline::after {
		background: var(--accent-grad);
		box-shadow: 0 0 18px color-mix(in srgb, var(--cyan) 60%, transparent);
		transform: scaleY(var(--p, 0));
		transform-origin: top;
	}
	.timeline li {
		position: relative;
		display: grid;
		grid-template-columns: 3.2rem 1fr;
		gap: 1.1rem;
		align-items: start;
		align-content: start;
	}
	.node {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 50%;
		background: var(--glass-solid);
		box-shadow: inset 0 0 0 1.5px var(--stroke-hi);
		color: var(--muted);
		transition:
			background 0.6s var(--ease),
			color 0.6s,
			box-shadow 0.6s,
			transform 0.7s var(--ease);
	}
	.node b {
		position: absolute;
		top: -0.35rem;
		right: -0.35rem;
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 50%;
		background: var(--glass-solid);
		box-shadow: inset 0 0 0 1px var(--stroke-hi);
		font-family: var(--display);
		font-size: 0.7rem;
		color: var(--ink-2);
	}
	.timeline li:global(.on) .node {
		background: var(--accent-grad);
		color: var(--on-accent);
