---
import Base from '../layouts/Base.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Faq from '../components/Faq.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import {
	SITE_TITLE,
	SITE_TAGLINE,
	SITE_DESCRIPTION,
	SITE_URL,
	WHATSAPP_URL,
	WHATSAPP_DISPLAY,
	INSTAGRAM_URL,
	FACEBOOK_URL,
	TIKTOK_URL,
	socials,
} from '../consts';
import { services, quoteHref } from '../data/services';
import { business, policies } from '../data/site';

const trust = [
	{ icon: 'pin', text: `Local to ${business.serviceArea}` },
	{ icon: 'chat', text: 'Quotes on WhatsApp' },
	{ icon: 'quote', text: 'A quote before any work' },
	{ icon: 'wrench', text: 'Phones and laptops, all brands' },
] as const;

const steps = [
	{ icon: 'chat', title: "Tell us what's wrong", text: 'Use the quote form or message us directly. Add the make and model, and a photo if you can.' },
	{ icon: 'quote', title: 'Get a quote', text: 'We reply on WhatsApp or Instagram with what it needs and what it costs.' },
	{ icon: 'wrench', title: 'Get it fixed', text: 'Say yes to the quote and we get to work. If we cannot fix it, we will tell you.' },
] as const;

const why = [
	{ icon: 'pin', title: 'Local and easy to reach', text: `A ${business.serviceArea} business you can message directly on WhatsApp, Instagram, TikTok or Facebook.` },
	{ icon: 'quote', title: 'A quote before any work', text: 'You hear what it needs and what it costs first. Work starts when you say yes.' },
	{ icon: 'shield', title: 'Straight answers', text: 'If it is not worth repairing, or we cannot fix it, we will tell you plainly.' },
	{ icon: 'wrench', title: 'Repair, do not replace', text: 'Fixing the device you already own is often the better choice. Ask us and we will tell you.' },
] as const;

const faqs = [
	{ q: 'How do I get a quote?', a: 'Use the quote form on this page. Pick your device and the problem, add a few details and send the ready-made message on WhatsApp. You can also message us directly on WhatsApp or Instagram. We reply with what it needs and the price, usually within 30 minutes.' },
	{ q: 'Which devices do you repair?', a: 'Phones and laptops, all brands. If your device is something else, message us and ask.' },
	{ q: 'Can you fix my model?', a: 'Send us the make and model and what is wrong with it. If we cannot fix it, we will tell you.' },
	{ q: 'What should I send with my message?', a: 'The make and model, what happened and when it started. A photo of any damage helps a lot.' },
	{ q: 'My device got wet. What should I do?', a: 'Switch it off straight away, do not try to charge it and message us. Acting quickly gives it the best chance.' },
	{ q: 'Do I need to message first?', a: 'Yes. Message us on WhatsApp with your device and the problem. We confirm the price and whether it needs drop-off before you bring it in.' },
	{ q: 'Do you offer delivery?', a: `${policies.coverage}` },
	{ q: 'Do you need a deposit?', a: `${policies.deposit}` },
	{ q: 'How long do you keep my device?', a: `${policies.storage}` },
	{ q: 'How long does a repair take?', a: `${policies.repairTime}` },
	{ q: 'Can you recover my data?', a: `${policies.dataRecovery} We recommend backing up anything important first.` },
	{ q: 'How do I pay?', a: `${policies.payment}` },
	{ q: 'Do I have to leave my device with you?', a: `${policies.dropOff}` },
	{ q: 'What is the fastest way to reach you?', a: `WhatsApp on ${WHATSAPP_DISPLAY}. You can also message us on Instagram, TikTok or Facebook.` },
	...(business.warranty ? [{ q: 'Do you offer a warranty?', a: business.warranty }] : []),
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: SITE_URL,
	image: `${SITE_URL}/og.png`,
	telephone: '+18687200146',
	areaServed: { '@type': 'AdministrativeArea', name: 'Trinidad' },
	sameAs: [INSTAGRAM_URL, FACEBOOK_URL, TIKTOK_URL],
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Repair services',
		itemListElement: services.map((s) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: s.name, url: `${SITE_URL}/services/${s.slug}` },
		})),
	},
};


---

<Base title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} schema={schema}>
	<!-- ============ Hero ============ -->
	<section class="hero" id="top">
		<div class="wrap hero-grid">
			<div class="copy">
				<span class="eyebrow reveal">Local tech repair · {business.serviceArea}</span>
				<h1 class="reveal-lines">
					<span class="line" style="--i:0"><span>Phone buss?</span></span>
					<span class="line" style="--i:1"><span>Laptop slow?</span></span>
					<span class="line" style="--i:2"><span class="grad">We'll sort it out.</span></span>
				</h1>
				<p class="lead reveal" style="--d:3">
					{SITE_TITLE} repairs phones and laptops, all brands, across Trinidad. Tell us what is wrong
					and we will send you a quote on WhatsApp.
				</p>
				<div class="cta-row reveal" style="--d:4">
					<a class="btn btn-wa btn-lg" href={WHATSAPP_URL} target="_blank" rel="noopener">
						<BrandIcon name="whatsapp" size={20} /> Message us on WhatsApp
					</a>
					<a class="btn btn-glass btn-lg" href="#quote">
						Build a repair quote <Icon class="arrow" name="arrow" size={18} stroke={2.2} />
					</a>
				</div>
				<div class="follow reveal" style="--d:5">
					<span>Also on</span>
					<ul>
						{
							socials.slice(1).map((s) => (
								<li>
									<a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label} ${s.handle}`}>
										<BrandIcon name={s.name} size={18} />
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<aside class="ticket reveal" style="--d:2" aria-label="Shop details">
				<dl>
					<div>
						<dt>Quote</dt>
						<dd>Before any work starts</dd>
					</div>
					<div>
						<dt>Devices</dt>
						<dd>Phones and laptops, all brands</dd>
					</div>
					<div>
						<dt>Area</dt>
						<dd>{business.serviceArea}</dd>
					</div>
					{
						business.address && (
							<div>
								<dt>Address</dt>
								<dd>{business.address}</dd>
							</div>
						)
					}
					{
						business.hours.map((h) => (
							<div>
								<dt>{h.days}</dt>
								<dd class="mono">{h.time}</dd>
							</div>
						))
					}
					{
						business.warranty && (
							<div>
								<dt>Warranty</dt>
								<dd>{business.warranty}</dd>
							</div>
						)
					}
				</dl>
			</aside>
		</div>

		<div class="wrap">
			<ul class="trust reveal" style="--d:6">
				{
					trust.map((t) => (
						<li>
							<Icon name={t.icon} size={20} />
							<span>{t.text}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============ Services ============ -->
	<section class="section" id="services">
		<div class="wrap">
			<div class="section-head head-split">
				<div class="reveal">
					<h2>Whatever is broken, <span class="grad">start here</span>.</h2>
				</div>
				<p class="lead reveal" style="--d:1">
					Pick the device to see what we fix. Not on the list? Message us and ask. We will tell you if we can help.
				</p>
			</div>

			<ul class="ledger">
				{
					services.map((s, i) => (
						<li class="reveal" style={`--d:${i % 3}`}>
							<a class="row" href={`/services/${s.slug}`}>
								<span class="svc-ico"><Icon name={s.icon} size={26} /></span>
								<span class="row-main">
									<h3>{s.cardTitle}</h3>
									<p>{s.cardText}</p>
								</span>
								<span class="row-fixes" aria-label="Common fixes">
									{s.problems.slice(0, 3).map((p) => (
										<span>{p.title}</span>
									))}
								</span>
								<span class="more">
									Explore <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
								</span>
							</a>
						</li>
					))
				}
				<li class="reveal" style="--d:1">
					<a class="row" href="/?device=other#quote">
						<span class="svc-ico"><Icon name="other" size={26} /></span>
						<span class="row-main">
							<h3>Not sure what it is?</h3>
							<p>Tell us what is going on and we will let you know whether we can help.</p>
						</span>
						<span class="row-fixes" aria-hidden="true"></span>
						<span class="more">
							Ask us <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
						</span>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<!-- ============ Quote ============ -->
	<section class="section" id="quote" data-hide-fab>
		<div class="wrap quote-grid">
			<div class="quote-intro">
				<div class="reveal">
					<h2>Your message, <span class="grad">written for you</span>.</h2>
					<p class="lead">Pick the device, tell us the problem, review it and send it on WhatsApp. No account needed.</p>
				</div>
				<ol class="how-mini reveal" style="--d:1">
					<li><span class="n">1</span><span>Choose your device and what is going on</span></li>
					<li><span class="n">2</span><span>Add the model and any details</span></li>
					<li><span class="n">3</span><span>Review and send it on WhatsApp</span></li>
				</ol>
				<p class="alt reveal" style="--d:2">
					Prefer to type it yourself?
					<a href={WHATSAPP_URL} target="_blank" rel="noopener">Message us on WhatsApp</a>.
				</p>
			</div>
			<div class="reveal" style="--d:1">
				<QuoteWizard />
			</div>
		</div>
	</section>

	<!-- ============ How it works ============ -->
	<section class="section" id="process">
		<div class="wrap">
			<div class="section-head reveal">
				<h2>Three steps, <span class="grad">no guesswork</span>.</h2>
			</div>
			<ol class="steps">
				{
					steps.map((s, i) => (
						<li class="reveal" style={`--d:${i}`}>
							<span class="num mono">{String(i + 1).padStart(2, '0')}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============ Why FixCore ============ -->
	<section class="section" id="why">
		<div class="wrap why-grid">
			<div class="why-copy reveal">
				<h2>Repairs that feel <span class="grad">straightforward</span>.</h2>
				<p class="lead">No jargon and no runaround. Just a local team that tells you what is going on.</p>
			</div>
			<ul class="why-list">
				{
					why.map((w, i) => (
						<li class="reveal" style={`--d:${i}`}>
							<article>
								<span class="why-ico"><Icon name={w.icon} size={22} /></span>
								<h3>{w.title}</h3>
								<p>{w.text}</p>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<Gallery />
	<Testimonials />

	<ContactSection />

	<!-- ============ FAQ ============ -->
	<section class="section" id="faq">
		<div class="wrap faq-grid">
			<div class="faq-copy reveal">
				<h2>Good <span class="grad">questions</span>.</h2>
				<p class="lead">Cannot find your answer? Message us and we will get back to you.</p>
				<a class="btn btn-glass" href={WHATSAPP_URL} target="_blank" rel="noopener">
					<BrandIcon name="whatsapp" size={18} /> Ask on WhatsApp
				</a>
			</div>
			<Faq items={faqs} />
		</div>
	</section>

	<CtaBand />
</Base>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		padding: clamp(7.5rem, 14vw, 10rem) 0 clamp(2rem, 5vw, 3.5rem);
	}
	.hero-grid {
		display: grid;
		gap: 3rem;
		align-items: center;
	}
	@media (min-width: 980px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			gap: 4rem;
		}
	}
	h1 {
		margin-bottom: 1.4rem;
		font-size: clamp(2.5rem, 7vw, 5rem);
	}
	@media (min-width: 980px) {
		/* Each phrase stays on its own line beside the ticket */
		h1 {
			font-size: clamp(2.6rem, 4.6vw, 4.25rem);
		}
		h1 .line > span {
			white-space: nowrap;
		}
	}
	.hero .lead {
		max-width: 31em;
		margin-bottom: 2rem;
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}
	.cta-row .btn {
		white-space: normal;
		text-align: center;
	}
	@media (min-width: 480px) {
		.cta-row .btn {
			white-space: nowrap;
		}
	}
	.follow {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
		font-size: 0.9rem;
		color: var(--color-muted);
	}
	.follow ul {
		display: flex;
		gap: 0.5rem;
	}
	.follow a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-sm);
		box-shadow: inset 0 0 0 1px var(--color-rule);
		color: var(--color-ink);
		transition:
			background-color var(--dur-fast),
			color var(--dur-fast),
			box-shadow var(--dur-fast);
	}
	.follow a:hover {
		color: var(--color-accent);
		box-shadow: inset 0 0 0 1px var(--color-accent);
	}

	/* The shop-details ticket: real facts from site data, set like a spec sheet */
	.ticket {
		padding: 0.5rem 1.5rem;
		border-top: 2px solid var(--color-accent);
		background: var(--color-paper-2);
		border-radius: 0 0 var(--radius) var(--radius);
	}
	.ticket dl {
		margin: 0;
	}
	.ticket dl > div {
		display: grid;
		grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-rule);
	}
	.ticket dl > div:last-child {
		border-bottom: 0;
	}
	.ticket dt {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-faint);
		padding-top: 0.2rem;
	}
	.ticket dd {
		margin: 0;
		color: var(--color-ink);
		font-size: 0.98rem;
		line-height: 1.5;
	}
	.trust {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.75rem 1.5rem;
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding: 1.25rem 0;
		border-block: 1px solid var(--color-rule);
	}
	.trust li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-ink-2);
	}
	.trust :global(svg) {
		flex: none;
		color: var(--color-accent);
	}

	/* ---------- Services ledger ---------- */
	.head-split {
		display: grid;
		gap: 1rem 3rem;
		align-items: end;
	}
	@media (min-width: 900px) {
		.head-split {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		}
		.head-split .lead {
			margin: 0 0 0.35rem;
		}
	}
	.ledger {
		border-top: 1px solid var(--color-rule-hi);
	}
	.ledger > li {
		border-bottom: 1px solid var(--color-rule);
	}
	.row {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 0.5rem 1.25rem;
		align-items: start;
		padding: 1.6rem 0.25rem;
		color: var(--color-ink);
		text-decoration: none;
		transition: background-color var(--dur-fast);
	}
	.row:hover {
		color: var(--color-ink);
		background: var(--color-paper-2);
	}
	.svc-ico {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		color: var(--color-accent);
	}
	.row-main h3 {
		font-size: clamp(1.25rem, 2.2vw, 1.55rem);
		margin-bottom: 0.4rem;
	}
	.row-main p {
		margin: 0;
		color: var(--color-muted);
		max-width: 34em;
	}
	.row-fixes {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-faint);
	}
	.more {
		grid-column: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-accent);
	}
	.more :global(svg) {
		transition: transform var(--dur-base) var(--ease-out);
	}
	.row:hover .more {
		color: var(--color-accent-hover);
	}
	.row:hover .more :global(svg) {
		transform: translateX(6px);
	}
	@media (min-width: 900px) {
		.row {
			grid-template-columns: 3rem minmax(0, 1.3fr) minmax(0, 1fr) auto;
			align-items: center;
			gap: 1.5rem;
			padding-inline: 1rem;
		}
		.row-fixes,
		.more {
			grid-column: auto;
		}
		.row-fixes {
			flex-direction: column;
			gap: 0.3rem;
		}
	}

	/* ---------- Quote ---------- */
	.quote-grid {
		display: grid;
		gap: 2.5rem;
		align-items: start;
	}
	@media (min-width: 1000px) {
		.quote-grid {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr);
			gap: 4rem;
		}
		.quote-intro {
			position: sticky;
			top: 7rem;
		}
	}
	.quote-intro h2,
	.why-copy h2,
	.faq-copy h2 {
		font-size: clamp(1.8rem, 3.3vw, 2.7rem);
	}
	.how-mini {
		display: grid;
		gap: 0.9rem;
		margin: 2rem 0 1.5rem;
	}
	.how-mini li {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		color: var(--color-ink-2);
	}
	.how-mini .n {
		flex: none;
		width: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--color-accent);
	}
	.alt {
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	/* ---------- Steps ---------- */
	.steps {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-rule-hi);
	}
	.steps li {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--color-rule);
	}
	.steps .num {
		display: block;
		margin-bottom: 1rem;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1;
		color: var(--color-accent);
	}
	.steps h3 {
		margin-bottom: 0.5rem;
	}
	.steps p {
		margin: 0;
		color: var(--color-muted);
	}
	@media (min-width: 900px) {
		.steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.steps li {
			padding: 2rem 2rem 2rem 0;
			border-bottom: 0;
		}
		.steps li + li {
			padding-left: 2rem;
			border-left: 1px solid var(--color-rule);
		}
	}

	/* ---------- Why ---------- */
	.why-grid {
		display: grid;
		gap: 2.5rem;
		align-items: start;
	}
	@media (min-width: 1000px) {
		.why-grid {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr);
			gap: 4rem;
		}
		.why-copy {
			position: sticky;
			top: 7rem;
		}
	}
	.why-list {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-rule-hi);
	}
	@media (min-width: 640px) {
		.why-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 2.5rem;
		}
	}
	.why-list article {
		height: 100%;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--color-rule);
	}
	.why-ico {
		display: block;
		margin-bottom: 1rem;
		color: var(--color-accent);
	}
	.why-list h3 {
		margin-bottom: 0.5rem;
	}
	.why-list p {
		margin: 0;
		color: var(--color-muted);
	}

	/* ---------- FAQ ---------- */
	.faq-grid {
		display: grid;
		gap: 2.5rem;
		align-items: start;
	}
	@media (min-width: 1000px) {
		.faq-grid {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
			gap: 4rem;
		}
		.faq-copy {
			position: sticky;
			top: 7rem;
		}
	}
	.faq-copy .btn {
		margin-top: 0.5rem;
	}
</style>
