---
import Base from '../layouts/Base.astro';
import Model3D from '../components/Model3D.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_URL, WHATSAPP_NUMBER, WHATSAPP_URL, WHATSAPP_DISPLAY, INSTAGRAM_URL, FACEBOOK_URL, TIKTOK_URL, socials } from '../consts';
import { services } from '../data/services';
import { models } from '../data/models3d';
import { business, policies, schedule } from '../data/site';

const tilePoster = { 'phone-repair': models.phone.poster, 'laptop-repair': models.laptop.poster, 'desktop-repair': models.pc.poster, diagnostics: models.wrench.poster } as Record<string, string>;
const hoursLine = business.hours.map((h) => `${h.days} ${h.time}`).join(' · ');
const otherSocials = socials.filter((s) => s.name !== 'whatsapp');

const faqs = [
  { q: 'How do I get a quote?', a: 'Pick your device and problem in the quote builder, add the model and send the prepared message on WhatsApp. We will reply with what it needs and what it costs.' },
  { q: 'Do I need to message before bringing a device?', a: 'Yes. Message us first so we can confirm the repair and arrange drop-off at 3 Alice Street, Curepe.' },
  { q: 'My device got wet. What should I do?', a: 'Switch it off, do not try to charge it, and message us with the model and what happened.' },
  { q: 'Do you need a deposit?', a: policies.deposit },
  { q: 'Do you offer a warranty?', a: business.warranty || 'Message us to confirm the terms for your repair.' },
  { q: 'How do I pay?', a: policies.payment },
];

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const hhmm = (h: number) => `${String(h).padStart(2, '0')}:00`;
const [street, town] = business.address.split(',').map((p) => p.trim());
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  image: `${SITE_URL}/og.png`,
  logo: `${SITE_URL}/logo-mark.png`,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: { '@type': 'PostalAddress', streetAddress: street, addressLocality: town, addressCountry: 'TT' },
  openingHoursSpecification: schedule.map((s) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: s.days.map((d) => dayNames[d]), opens: hhmm(s.from), closes: hhmm(s.to) })),
  areaServed: { '@type': 'AdministrativeArea', name: business.serviceArea },
  sameAs: [INSTAGRAM_URL, FACEBOOK_URL, TIKTOK_URL],
};
---
<Base title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} schema={schema}>
  <!-- 1. Hero: one button, one quiet link -->
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Local tech repair · {business.serviceArea}</p>
        <h1>Phone buss?<br />Laptop slow?<br /><span class="grad">We'll sort it out.</span></h1>
        <p class="lead">Phones, laptops and PCs. Tell us what is wrong. Get a quote before any work starts.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href="#quote">Get a quote</a>
          <a class="text-link" href={WHATSAPP_URL} target="_blank" rel="noopener">or message us on WhatsApp</a>
        </div>
        <p class="hero-meta"><Icon name="pin" size={16} /><span>{business.address} · {hoursLine}</span></p>
      </div>
      <div class="hero-device">
        <figure class="device-study">
          <Model3D model="phone" priority />
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. Services: whole card is the link -->
  <section class="section services-section" id="services">
    <div class="wrap">
      <div class="section-head split-head"><h2 data-tag="Repair services">What needs<br /><span class="grad">a second life?</span></h2><p class="lead">Start with your device. We will help work out what it needs.</p></div>
      <div class="service-grid">
        {services.map((service, i) => (
          <a class={`service-tile service-${i}`} href={`/services/${service.slug}`}>
            <div class="mini-stage" aria-hidden="true" data-motion-scene>
              <img class="mini-img" src={tilePoster[service.slug]} alt="" width="720" height="720" loading="lazy" decoding="async" />
            </div>
            <div class="service-copy"><h3>{service.cardTitle}</h3><p>{service.cardText}</p></div>
          </a>
        ))}
      </div>
      <a class="software-banner" href="/services/phone-software-unlocking">
        <span class="sb-ico"><Icon name="unlock" size={28} /></span>
        <span class="sb-copy"><b>Phone Software &amp; Unlocking</b><span>FRP removal, firmware flashing, bootloop repair and network unlocking on supported devices.</span></span>
        <span class="sb-go">View services <Icon name="arrow" size={16} stroke={2.2} /></span>
      </a>
    </div>
  </section>

  <!-- 3. How it works, beside the laptop model -->
  <section class="section workshop" id="process">
    <div class="wrap workshop-grid">
      <div class="workshop-visual"><Model3D model="laptop" /></div>
      <div class="workshop-copy">
        <h2 data-tag="From the inside out">A small part.<br /><span class="grad">A big difference.</span></h2>
        <p class="lead">A tired battery. A damaged screen. A laptop that runs too hot. Tell us the symptoms and we will help identify the repair.</p>
        <div class="repair-flow">
          <p><b>You tell us.</b><span>Send the model, problem and a photo if you can.</span></p>
          <p><b>You decide.</b><span>We explain the repair and quote before starting.</span></p>
          <p><b>We repair.</b><span>Once you approve, we get to work.</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Quote builder: the one main action -->
  <section class="section quote-section" id="quote" data-hide-fab>
    <div class="wrap quote-grid">
      <div><h2 data-tag="Request a repair">Let's get<br /><span class="grad">to the problem.</span></h2><p class="lead">Choose your device, add the details and review your message. You send it in WhatsApp when you are ready.</p><p class="quote-note">No account needed. No message sent automatically.</p></div>
      <div class="quote-platform"><QuoteWizard /></div>
    </div>
  </section>

  <!-- 5. Contact details and questions together -->
  <section class="section" id="contact" data-hide-fab>
    <div class="wrap faq-grid">
      <div class="reach">
        <h2 data-tag="Before you bring it in">Questions?<br /><span class="grad">Ask away.</span></h2>
        <p class="lead">Message us on WhatsApp and we will tell you what it needs and what it costs.</p>
        <dl class="facts">
          <div><dt>Drop-off and collection</dt><dd>{business.address}</dd></div>
          <div><dt>Hours</dt><dd>{business.hours.map((h) => <span>{h.days}: {h.time}</span>)}</dd></div>
          <div><dt>WhatsApp</dt><dd><a href={WHATSAPP_URL} target="_blank" rel="noopener">{WHATSAPP_DISPLAY}</a></dd></div>
        </dl>
        <p class="social-line">{otherSocials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>
        <p class="more">More detail on parts, collection and storage is in our <a href="/terms">repair terms</a>.</p>
      </div>
      <div><span id="faq" class="anchor"></span><Faq items={faqs} /></div>
    </div>
  </section>
</Base>
<style>
.hero { padding:clamp(7.5rem,12vw,10rem) 0 clamp(2rem,5vw,4rem); overflow:hidden; }
.hero-grid { display:grid; gap:2rem; align-items:center; }
.hero-copy h1 { font-size:clamp(2.65rem,5.1vw,4.6rem); margin-bottom:1.6rem; }
.hero-copy .lead { max-width:28em; }
.cta-row { display:flex; flex-wrap:wrap; align-items:center; gap:1rem 1.5rem; margin-top:2rem; }
.cta-row .btn { white-space:normal; }
.hero-meta { display:flex; align-items:flex-start; gap:.6rem; margin:2rem 0 0; color:var(--color-muted); font-size:.85rem; line-height:1.5; max-width:34em; }
.hero-meta :global(svg) { flex:none; margin-top:.15em; color:var(--color-accent); }
.hero-device { min-width:0; }
.device-study { margin:0; min-width:0; }
.device-study :global(.m3d) { padding-bottom:1rem; }

.split-head { display:grid; gap:1rem; align-items:end; }
.split-head .lead { max-width:23em; }

.service-grid { display:grid; gap:1.25rem; }
.service-tile { display:flex; flex-direction:column; text-decoration:none; color:var(--color-ink); border:1px solid var(--color-rule-hi); border-radius:12px; background:var(--color-paper-2); overflow:hidden; position:relative; transition:border-color .2s, transform .3s var(--ease); }
.service-tile:hover { color:var(--color-ink); border-color:var(--color-accent); transform:translateY(-3px); }
.service-copy { padding:1.4rem; }
.service-copy h3 { font-size:1.3rem; }
.service-copy p { color:var(--color-muted); font-size:.95rem; margin:.8rem 0 0; }
.mini-stage { height:165px; position:relative; background:var(--color-paper-3); overflow:hidden; }
.mini-stage > .mini-img { position:absolute; left:50%; top:50%; height:90%; width:auto; max-width:88%; object-fit:contain; transform:translate(-50%,-50%); animation:mini-bob 9s ease-in-out infinite; filter:drop-shadow(0 10px 12px rgba(0,0,0,.35)); }
.service-1 .mini-img { animation-delay:-2s; }
.service-2 .mini-img { animation-delay:-4s; }
.service-3 .mini-img { animation-delay:-6s; }
@keyframes mini-bob { 0%,100% { transform:translate(-50%,-48%); } 50% { transform:translate(-50%,-53%); } }

.software-banner { display:flex; align-items:center; gap:1.2rem; margin-top:1.25rem; padding:1.2rem 1.4rem; text-decoration:none; color:var(--color-ink); border:1px solid var(--color-rule-hi); border-left:3px solid var(--color-accent); border-radius:12px; background:var(--color-paper-2); transition:border-color .2s, transform .3s var(--ease); }
.software-banner:hover { color:var(--color-ink); border-color:var(--color-accent); transform:translateY(-3px); }
.sb-ico { display:grid; place-items:center; flex:none; width:3.4rem; height:3.4rem; border-radius:var(--radius); background:color-mix(in srgb, var(--blue-strong) 16%, transparent); box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--blue) 30%, transparent); color:var(--blue); }
.sb-copy { display:grid; gap:.2rem; min-width:0; }
.sb-copy b { font-family:var(--display); font-size:1.2rem; letter-spacing:-.02em; }
.sb-copy span { color:var(--color-muted); font-size:.92rem; }
.sb-go { display:inline-flex; align-items:center; gap:.5rem; margin-left:auto; flex:none; font-family:var(--display); font-weight:600; font-size:.92rem; color:var(--color-accent); }
@media(max-width:700px) { .software-banner { flex-wrap:wrap; } .sb-go { margin-left:0; width:100%; } }
@media(prefers-reduced-motion:reduce) { .software-banner { transition:border-color .2s; } .software-banner:hover { transform:none; } }

.workshop { background:var(--color-paper-2); }
.workshop-grid { display:grid; gap:2rem; align-items:center; }
.workshop-copy .lead { margin-top:1.4rem; }
.repair-flow { margin:2rem 0 0; }
.repair-flow p { display:grid; gap:.25rem; padding:1rem 0; border-bottom:1px solid var(--color-rule); margin:0; }
.repair-flow b { color:var(--color-ink); }
.repair-flow span { color:var(--color-muted); font-size:.9rem; }

.quote-grid, .faq-grid { display:grid; gap:2.5rem; }
.quote-grid .lead, .faq-grid .lead { margin-top:1.5rem; }
.quote-note { color:var(--color-muted); font-size:.85rem; }
.quote-platform { perspective:1200px; }
.quote-platform :global(.wizard) { box-shadow:8px 10px 0 -2px var(--color-paper-3); border:1px solid var(--color-rule-hi); background:var(--color-paper-2); }

.facts { display:grid; gap:1.1rem; margin:2rem 0 1.5rem; }
.facts > div { display:grid; gap:.25rem; padding-bottom:1.1rem; border-bottom:1px solid var(--color-rule); }
.facts dt { font-family:var(--font-mono); font-size:.75rem; letter-spacing:.08em; text-transform:uppercase; color:var(--color-muted); }
.facts dd { margin:0; color:var(--color-ink); }
.facts dd span { display:block; }
.social-line { display:flex; flex-wrap:wrap; gap:.4rem 1.4rem; margin:0 0 1.2rem; font-size:.95rem; }
.more { color:var(--color-muted); font-size:.9rem; }
.anchor { display:block; position:relative; top:-6rem; height:0; visibility:hidden; }

@media(min-width:700px) { .service-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .split-head { grid-template-columns:1fr 1fr; } }
@media(min-width:1000px) {
  .hero-grid { grid-template-columns:1.05fr 1fr; gap:3rem; }
  .workshop-grid { grid-template-columns:1.15fr 1fr; gap:4rem; }
  .quote-grid { grid-template-columns:.8fr 1.2fr; gap:4rem; }
  .faq-grid { grid-template-columns:.8fr 1.2fr; gap:4rem; }
  .service-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }
  .service-copy { padding:1.2rem; }
  .service-copy h3 { font-size:1.15rem; }
  .service-copy p { font-size:.88rem; }
}
@media(max-width:500px) {
  .hero { padding-top:7.5rem; }
  .hero-device { margin-top:1rem; }
  .hero-grid { gap:1rem; }
  .workshop-copy { order:-1; }
  .cta-row .btn { flex:1 1 100%; }
  .service-tile { flex-direction:row; }
  .mini-stage { flex:0 0 112px; height:auto; min-height:180px; }
  .service-copy { padding:1.1rem; }
  .service-copy h3 { font-size:1.1rem; }
  .service-copy p { font-size:.85rem; }
}
:global([data-motion='paused']) .mini-img { animation-play-state:paused; }
@media(prefers-reduced-motion:reduce) { .mini-stage > .mini-img { animation:none; } .service-tile { transition:border-color .2s; } .service-tile:hover { transform:none; } }
</style>
