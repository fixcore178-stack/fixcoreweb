---
import Base from '../layouts/Base.astro';
import DeviceScene from '../components/DeviceScene.astro';
import LaptopScene from '../components/LaptopScene.astro';
import MotionControl from '../components/MotionControl.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import ContactSection from '../components/ContactSection.astro';
import Faq from '../components/Faq.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_URL, WHATSAPP_URL, INSTAGRAM_URL, FACEBOOK_URL, TIKTOK_URL } from '../consts';
import { services } from '../data/services';
import { business, policies } from '../data/site';
const faqs = [
  {q:'How do I get a quote?',a:'Pick your device and problem in the quote builder, add the model and send the prepared message on WhatsApp. We will reply with what it needs and what it costs.'},
  {q:'Do I need to message before bringing a device?',a:'Yes. Message us first so we can confirm the repair and arrange drop-off at 3 Alice Street, Curepe.'},
  {q:'My device got wet. What should I do?',a:'Switch it off, do not try to charge it, and message us with the model and what happened.'},
  {q:'Do you need a deposit?',a:policies.deposit},
  {q:'Do you offer a warranty?',a:business.warranty || 'Message us to confirm the terms for your repair.'},
  {q:'How do I pay?',a:policies.payment},
];
const schema = {'@context':'https://schema.org','@type':'LocalBusiness',name:SITE_TITLE,description:SITE_DESCRIPTION,url:SITE_URL,telephone:'+18687200146',areaServed:{'@type':'AdministrativeArea',name:business.serviceArea},sameAs:[INSTAGRAM_URL,FACEBOOK_URL,TIKTOK_URL]};
---
<Base title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} schema={schema}>
  <MotionControl />
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Local tech repair · {business.serviceArea}</p>
        <h1>Phone buss?<br />Laptop slow?<br /><span class="grad">We'll sort it out.</span></h1>
        <p class="lead">Phones, laptops and PCs. Tell us what is wrong. Get a quote before any work starts.</p>
        <div class="cta-row"><a class="btn btn-primary btn-lg" href="#quote">Build my repair quote</a><a class="btn btn-glass btn-lg" href={WHATSAPP_URL} target="_blank" rel="noopener"><BrandIcon name="whatsapp" size={20} /> WhatsApp us</a></div>
        <p class="hero-note">Your everyday tech. Worth another look.</p>
      </div>
      <div class="hero-device"><DeviceScene /></div>
    </div>
    <div class="wrap"><div class="location-strip"><span><Icon name="pin" size={18} />{business.address}</span><span>Quotes on WhatsApp</span><a href="#contact">Hours & contact</a></div></div>
  </section>

  <section class="section services-section" id="services">
    <div class="wrap">
      <div class="section-head split-head"><h2 data-tag="Repair services">What needs<br /><span class="grad">a second life?</span></h2><p class="lead">Start with your device. We will help work out what it needs.</p></div>
      <div class="service-grid">
        {services.map((service,i)=>(
          <a class={`service-tile service-${i} depth-surface`} href={`/services/${service.slug}`}>
            <div class="mini-stage" aria-hidden="true" data-motion-scene>
              {i===0 ? <div class="mini-phone"><span></span><i></i></div> : i===1 ? <div class="mini-laptop"><span></span><i></i></div> : i===2 ? <div class="mini-pc"><span></span><i></i><i></i></div> : <div class="mini-chip"><span></span></div>}
            </div>
            <div class="service-copy"><h3>{service.cardTitle}</h3><p>{service.cardText}</p><span class="service-link">View repair options <Icon name="arrow" size={16} /></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section workshop" id="process">
    <div class="wrap workshop-grid">
      <div class="workshop-visual"><LaptopScene /></div>
      <div class="workshop-copy">
        <h2 data-tag="From the inside out">A small part.<br /><span class="grad">A big difference.</span></h2>
        <p class="lead">A tired battery. A damaged screen. A laptop that runs too hot. Tell us the symptoms and we will help identify the repair.</p>
        <div class="repair-flow">
          <p><b>You tell us.</b><span>Send the model, problem and a photo if you can.</span></p>
          <p><b>You decide.</b><span>We explain the repair and quote before starting.</span></p>
          <p><b>We repair.</b><span>Once you approve, we get to work.</span></p>
        </div>
        <a class="text-link" href="#quote">Describe my device problem</a>
      </div>
    </div>
  </section>

  <section class="section quote-section" id="quote" data-hide-fab>
    <div class="wrap quote-grid">
      <div><h2 data-tag="Request a repair">Let's get<br /><span class="grad">to the problem.</span></h2><p class="lead">Choose your device, add the details and review your message. You send it in WhatsApp when you are ready.</p><p class="quote-note">No account needed. No message sent automatically.</p><a class="text-link" href={WHATSAPP_URL} target="_blank" rel="noopener">Prefer to message us directly?</a></div>
      <div class="quote-platform"><QuoteWizard /></div>
    </div>
  </section>

  <ContactSection />
  <section class="section" id="faq"><div class="wrap faq-grid"><div><h2 data-tag="Before you bring it in">A few useful<br /><span class="grad">answers.</span></h2><p class="lead">More detail on parts, collection and storage is in our <a href="/terms">repair terms</a>.</p></div><Faq items={faqs} /></div></section>
</Base>
<style>
.hero { padding:clamp(7.5rem,12vw,10rem) 0 0; overflow:hidden; }
.hero-grid { display:grid; gap:2rem; align-items:center; }
.hero-copy h1 { font-size:clamp(2.65rem,5.1vw,4.6rem); margin-bottom:1.6rem; }
.hero-copy .lead { max-width:28em; }.cta-row { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:2rem; }.cta-row .btn { white-space:normal; }
.hero-note { color:var(--color-muted); font-size:.85rem; margin:1.5rem 0 0; }.hero-device { min-width:0; }
.location-strip { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:1rem; padding:1.4rem 0; border-block:1px solid var(--color-rule-hi); margin-top:3rem; font-size:.85rem; color:var(--color-ink-2); }.location-strip span:first-child { display:flex; align-items:center; gap:.6rem; }.location-strip :global(svg) { color:var(--color-accent); }
.split-head { display:grid; gap:1rem; align-items:end; }.split-head .lead { max-width:23em; }
.service-grid { display:grid; gap:1.25rem; }.service-tile { display:flex; flex-direction:column; text-decoration:none; color:var(--color-ink); border:1px solid var(--color-rule-hi); border-radius:12px; background:var(--color-paper-2); overflow:hidden; position:relative; box-shadow:0 9px 0 -4px var(--color-paper-3); }.service-tile:hover { color:var(--color-ink); border-color:var(--color-accent); }.service-copy { padding:1.4rem; }.service-copy h3 { font-size:1.3rem; }.service-copy p { color:var(--color-muted); font-size:.95rem; margin:1rem 0 1.5rem; }.service-link { display:flex; align-items:center; gap:.6rem; color:var(--color-accent); font-size:.85rem; font-weight:600; }
.mini-stage { height:165px; position:relative; perspective:700px; background:var(--color-paper-3); overflow:hidden; }.mini-stage > div { position:absolute; left:50%; top:50%; transform-style:preserve-3d; animation:object-turn 9s ease-in-out infinite; }.service-1 .mini-stage > div { animation-delay:-2s; }.service-2 .mini-stage > div { animation-delay:-4s; }.service-3 .mini-stage > div { animation-delay:-6s; }
.mini-phone { width:65px; height:118px; border:5px solid #8babb7; border-radius:13px; background:linear-gradient(135deg,#a5e2e2,#1a6377); box-shadow:5px 5px 0 #294653,12px 18px 15px #0003; }.mini-phone span { position:absolute; top:4px; width:22px; height:5px; background:#182e3a; left:16px; border-radius:5px; }.mini-phone i { position:absolute; inset:32px -3px -3px 22px; border:13px solid #267b8d; border-radius:50%; }
.mini-laptop { width:128px; height:84px; border:5px solid #869da8; border-radius:5px; background:linear-gradient(130deg,#8bd2d7,#17485b); box-shadow:4px 4px 0 #314e5f; }.mini-laptop i { position:absolute; left:-15px; right:-15px; bottom:-28px; height:28px; background:linear-gradient(#a5bac4,#526f7f); transform:rotateX(55deg); transform-origin:top; border-radius:0 0 6px 6px; }
.mini-pc { width:65px; height:106px; border:3px solid #8ca6b2; background:#243f4f; border-radius:5px; box-shadow:20px -12px 0 #456271; }.mini-pc i { position:absolute; left:10px; top:12px; width:38px; height:38px; border:7px dashed #7acbd4; border-radius:50%; animation:fan-mini 6s linear infinite; }.mini-pc i:last-child { top:57px; }.mini-chip { width:86px; height:86px; background:repeating-linear-gradient(90deg,#91b5bd 0 4px,transparent 4px 9px); padding:8px; }.mini-chip span { display:block; width:100%; height:100%; border:5px solid #86a4b0; background:linear-gradient(140deg,#557480,#203b4c); box-shadow:6px 8px 0 #193342; }
.workshop { background:var(--color-paper-2); }.workshop-grid { display:grid; gap:2rem; align-items:center; }.workshop-copy .lead { margin-top:1.4rem; }.repair-flow { margin:2rem 0; }.repair-flow p { display:grid; gap:.25rem; padding:1rem 0; border-bottom:1px solid var(--color-rule); margin:0; }.repair-flow b { color:var(--color-ink); }.repair-flow span { color:var(--color-muted); font-size:.9rem; }.text-link { font-weight:600; font-size:.95rem; }.quote-grid,.faq-grid { display:grid; gap:2.5rem; }.quote-grid .lead,.faq-grid .lead { margin-top:1.5rem; }.quote-note { color:var(--color-muted); font-size:.85rem; }.quote-platform { perspective:1200px; }.quote-platform :global(.wizard) { box-shadow:8px 10px 0 -2px var(--color-paper-3); border:1px solid var(--color-rule-hi); background:var(--color-paper-2); }
@keyframes object-turn { 0%,100% { transform:translate(-50%,-50%) rotateX(4deg) rotateY(-12deg) rotateZ(-3deg) translateY(2px); } 50% { transform:translate(-50%,-50%) rotateX(4deg) rotateY(-12deg) rotateZ(-3deg) translateY(-3px); } }
@keyframes fan-mini { to { rotate:360deg; } }
@media(min-width:700px) { .service-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.split-head { grid-template-columns:1fr 1fr; } }
@media(min-width:1000px) { .hero-grid { grid-template-columns:1.05fr 1fr; gap:3rem; }.workshop-grid { grid-template-columns:1.15fr 1fr; gap:4rem; }.quote-grid { grid-template-columns:.8fr 1.2fr; gap:4rem; }.faq-grid { grid-template-columns:.8fr 1.2fr; gap:4rem; }.service-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }.service-copy { padding:1.2rem; }.service-copy h3 { font-size:1.15rem; }.service-copy p { font-size:.88rem; }.service-1 { margin-top:2rem; }.service-3 { margin-top:2rem; }.service-tile { align-self:start; }.service-link { margin-top:auto; }.service-copy { display:flex; flex:1; flex-direction:column; } }
@media(max-width:500px) { .hero { padding-top:7.5rem; }.hero-device { margin-top:1rem; }.hero-grid { gap:1rem; }.location-strip { margin-top:1rem; font-size:.8rem; }.location-strip > span:nth-child(2) { display:none; }.workshop-copy { order:-1; }.cta-row .btn { flex:1 1 100%; }.service-tile { flex-direction:row; }.mini-stage { flex:0 0 100px; height:auto; min-height:210px; }.mini-stage > div { scale:.75; transform-origin:0 0; }.service-copy { padding:1.1rem; }.service-copy h3 { font-size:1.1rem; }.service-copy p { font-size:.85rem; }.service-link { font-size:.75rem; } }
:global([data-motion='paused']) .mini-stage > div,:global([data-motion='paused']) .mini-pc i { animation-play-state:paused; }
@media(prefers-reduced-motion:reduce) { .mini-stage > div,.mini-pc i { animation:none; } }
</style>
