---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE } from '../consts';
---

<Base title={`Page not found | ${SITE_TITLE}`} description="That page could not be found." noindex>
	<section class="lost">
		<div class="wrap">
			<p class="code reveal" aria-hidden="true">404</p>
			<h1 class="reveal" style="--d:1">This page <span class="grad">needs a repair</span>.</h1>
			<p class="lead reveal" style="--d:2">We could not find what you were looking for. Head back home or get a quote for your device.</p>
			<div class="row reveal" style="--d:3">
				<a class="btn btn-primary btn-lg" href="/">Back to home</a>
				<a class="btn btn-glass btn-lg" href="/#quote">
					Get a quote <Icon class="arrow" name="arrow" size={18} stroke={2.2} />
				</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.lost {
		display: grid;
		align-items: center;
		min-height: 88vh;
		padding: 9rem 0 4rem;
	}
	.code {
		margin: 0 0 0.5rem;
		font-family: var(--display);
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: clamp(4.5rem, 20vw, 12rem);
		line-height: 0.85;
		letter-spacing: -0.04em;
		color: var(--color-accent);
	}
	h1 {
		margin-bottom: 1rem;
		font-size: clamp(2rem, 5vw, 3.6rem);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 1.6rem;
	}
</style>
