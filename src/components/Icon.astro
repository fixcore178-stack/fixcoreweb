---
import { icons, type IconName } from '../data/icons';

interface Props {
	name: IconName;
	size?: number;
	stroke?: number;
	class?: string;
}
const { name, size = 24, stroke = 1.75, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width={stroke}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={icons[name]}
/>
