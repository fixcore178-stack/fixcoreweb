---
// Decorative circuit traces, echoing the circuit lines on the FixCore shield.
// Sits behind content; hidden from assistive tech.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class:list={['circuit', className]}
	viewBox="0 0 1200 700"
	preserveAspectRatio="xMidYMid slice"
	fill="none"
	aria-hidden="true"
	focusable="false"
>
	<g stroke="currentColor" stroke-width="2" stroke-linejoin="round">
		<path d="M0 120H170L230 180H430" />
		<path d="M0 300H80L140 360H300V520" />
		<path d="M0 470H120L170 520H240" />
		<path d="M1200 90H1020L960 150H800" />
		<path d="M1200 260H1100L1040 320H900V480L860 520H700" />
		<path d="M1200 560H990L930 620H760" />
		<path d="M320 700V650L360 610H540" />
		<path d="M1200 400H1150" />
	</g>
	<g fill="var(--circuit-node, #061a35)" stroke="currentColor" stroke-width="2">
		<circle cx="430" cy="180" r="6" />
		<circle cx="300" cy="520" r="6" />
		<circle cx="240" cy="520" r="6" />
		<circle cx="800" cy="150" r="6" />
		<circle cx="700" cy="520" r="6" />
		<circle cx="760" cy="620" r="6" />
		<circle cx="540" cy="610" r="6" />
		<circle cx="1150" cy="400" r="6" />
	</g>
</svg>

<style>
	.circuit {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		color: var(--blue);
		opacity: 0.55;
	}
</style>
