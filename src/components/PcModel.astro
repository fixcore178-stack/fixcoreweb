---
// Interactive 3D gaming PC. The heavy viewer library and the 2.9 MB model are only fetched once this
// element is on screen; until then (and if anything fails) the pre-rendered poster image is shown.
// Model: "Custom Gaming PC" by Yolala1232, CC BY 4.0 (credit shown below and in the footer).
interface Props {
	orbit?: string;
	label?: string;
	class?: string;
	credit?: boolean;
}
const {
	orbit = '-38deg 74deg auto',
	label = 'Interactive 3D model of a gaming PC. Drag to rotate.',
	class: cls = '',
	credit = true,
} = Astro.props;
---

<div class={`pc-model ${cls}`} data-pc-model data-src="/models/gaming-pc-v1.glb" data-orbit={orbit} data-label={label}>
	<div class="pc-frame">
		<img class="pc-poster" src="/models/gaming-pc-poster-v1.webp" alt={label} width="720" height="720" decoding="async" loading="lazy" />
		<button class="pc-load" type="button" hidden>Load 3D model (3 MB)</button>
		<span class="pc-hint" aria-hidden="true">Drag to rotate</span>
	</div>
	{
		credit && (
			<p class="pc-credit">
				3D model &ldquo;<a href="https://sketchfab.com/3d-models/custom-gaming-pc-1a24273417534f69afa0f7c62b643ffc" target="_blank" rel="noopener">Custom Gaming PC</a>&rdquo; by{' '}
				<a href="https://sketchfab.com/Yolala1232" target="_blank" rel="noopener">Yolala1232</a>,{' '}
				<a href="http://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>. Compressed for web. Illustration only; your PC will differ.
			</p>
		)
	}
</div>

<style is:global>
.pc-model { min-width: 0; }
.pc-frame { position: relative; width: 100%; aspect-ratio: 1; max-height: 78vh; margin-inline: auto; }
.pc-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .5s ease; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, .35)); }
.pc-model model-viewer { position: absolute; inset: 0; width: 100%; height: 100%; background: transparent; --poster-color: transparent; --progress-bar-color: var(--color-accent, #4bdcea); --progress-bar-height: 3px; outline: none; opacity: 0; transition: opacity .5s ease; cursor: grab; }
.pc-model model-viewer:active { cursor: grabbing; }
.pc-model.is-ready model-viewer { opacity: 1; }
.pc-model.is-ready .pc-poster { opacity: 0; pointer-events: none; }
.pc-model.is-failed model-viewer { display: none; }
.pc-hint { position: absolute; left: 50%; bottom: .25rem; translate: -50% 0; padding: .3rem .7rem; border-radius: 99px; background: var(--color-paper-2, #101c26); border: 1px solid var(--color-rule-hi, #29404f); color: var(--color-muted, #8fa5b3); font-size: .72rem; pointer-events: none; opacity: 0; transition: opacity .4s; }
.pc-model.is-ready .pc-hint { opacity: 1; }
.pc-model.is-ready.has-moved .pc-hint { opacity: 0; }
.pc-load { position: absolute; left: 50%; bottom: 8%; translate: -50% 0; min-height: 44px; padding: .6rem 1.1rem; border-radius: 6px; border: 1px solid var(--color-accent, #4bdcea); background: var(--color-paper-2, #101c26); color: var(--color-ink, #fff); font: 600 .85rem var(--font-body, sans-serif); cursor: pointer; }
.pc-load[hidden] { display: none; }
.pc-model.is-loading .pc-poster { animation: pc-pulse 1.4s ease-in-out infinite; }
.pc-credit { margin: .6rem 0 0; color: var(--color-muted, #8fa5b3); font-size: .72rem; line-height: 1.5; }
.pc-credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
.pc-credit a:hover { color: var(--color-accent, #4bdcea); }
@keyframes pc-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .6; } }
@media (prefers-reduced-motion: reduce) { .pc-model.is-loading .pc-poster { animation: none; } }
</style>

<script>
	let viewerReady: Promise<void> | null = null;
	function loadViewer(): Promise<void> {
		viewerReady ??= import('@google/model-viewer')
			.then(() => customElements.whenDefined('model-viewer'))
			.then((C: any) => {
				C.meshoptDecoderLocation = new URL('/models/meshopt_decoder.js', location.href).href;
			});
		return viewerReady;
	}

	const reduce = matchMedia('(prefers-reduced-motion: reduce)');
	const motionOn = () => !reduce.matches && document.documentElement.dataset.motion !== 'paused';
	const mounted = new Set<HTMLElement>();
	const syncRotate = () => mounted.forEach((mv) => (motionOn() ? mv.setAttribute('auto-rotate', '') : mv.removeAttribute('auto-rotate')));
	reduce.addEventListener('change', syncRotate);
	new MutationObserver(syncRotate).observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] });

	function mount(root: HTMLElement) {
		if (root.dataset.mounted) return;
		root.dataset.mounted = '1';
		root.classList.add('is-loading');
		const frame = root.querySelector('.pc-frame') as HTMLElement;
		loadViewer()
			.then(() => {
				const mv = document.createElement('model-viewer');
				const set = (k: string, v = '') => mv.setAttribute(k, v);
				set('src', root.dataset.src!);
				set('alt', root.dataset.label || '3D model of a gaming PC');
				set('camera-controls');
				set('camera-orbit', root.dataset.orbit || '-38deg 74deg auto');
				set('min-camera-orbit', 'auto 20deg auto');
				set('max-camera-orbit', 'auto 110deg auto');
				set('field-of-view', '28deg');
				set('disable-zoom');
				set('disable-pan');
				set('touch-action', 'pan-y');
				set('interaction-prompt', 'none');
				set('shadow-intensity', '1.1');
				set('shadow-softness', '1');
				set('environment-image', 'neutral');
				set('exposure', '1.15');
				set('rotation-per-second', '14deg');
				set('auto-rotate-delay', '2500');
				if (motionOn()) set('auto-rotate');
				mv.addEventListener('load', () => {
					root.classList.remove('is-loading');
					root.classList.add('is-ready');
					root.querySelector('.pc-poster')?.setAttribute('aria-hidden', 'true');
				});
				mv.addEventListener('camera-change', (e: any) => {
					if (e.detail?.source === 'user-interaction') root.classList.add('has-moved');
				});
				mv.addEventListener('error', () => {
					root.classList.remove('is-loading');
					root.classList.add('is-failed');
				});
				frame.prepend(mv);
				mounted.add(mv);
			})
			.catch(() => {
				root.classList.remove('is-loading');
				root.classList.add('is-failed');
			});
	}

	const saveData = Boolean((navigator as any).connection?.saveData);
	const io = 'IntersectionObserver' in window
		? new IntersectionObserver(
				(entries) =>
					entries.forEach((en) => {
						if (!en.isIntersecting) return;
						io!.unobserve(en.target);
						mount(en.target as HTMLElement);
					}),
				{ rootMargin: '300px' }
			)
		: null;

	document.querySelectorAll<HTMLElement>('[data-pc-model]').forEach((root) => {
		if (saveData) {
			const btn = root.querySelector<HTMLButtonElement>('.pc-load');
			if (btn) {
				btn.hidden = false;
				btn.addEventListener('click', () => {
					btn.hidden = true;
					mount(root);
				});
			}
		} else if (io) io.observe(root);
		else mount(root);
	});
</script>
