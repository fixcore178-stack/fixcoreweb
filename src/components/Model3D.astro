---
// Interactive 3D viewer for the real models listed in src/data/models3d.ts.
// The viewer library (about 950 kB) and the model are only fetched once the element is near the screen;
// until then, and if anything fails, the pre-rendered poster image is shown. Every model is CC BY 4.0,
// so the credit paragraph under the viewer must stay.
import { models, LICENSE_URL, type ModelKey } from '../data/models3d';
interface Props {
	model: ModelKey;
	class?: string;
	credit?: boolean;
	priority?: boolean; // above the fold: eager poster, viewer starts once the page has loaded
}
const { model, class: cls = '', credit = true, priority = false } = Astro.props;
const m = models[model];
---

<div
	class={`m3d ${cls}`}
	data-model3d
	data-src={m.src}
	data-orbit={m.orbit}
	data-label={m.label}
	data-priority={priority ? '1' : undefined}
	style={`--ratio:${m.ratio}`}
>
	<div class="m3d-frame">
		<img class="m3d-poster" src={m.poster} alt={m.label} width="720" height="720" decoding="async" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} />
		<button class="m3d-load" type="button" hidden>Load 3D model ({m.size})</button>
		<span class="m3d-hint" aria-hidden="true">Drag to rotate</span>
	</div>
	{
		credit && (
			<p class="m3d-credit">
				3D model &ldquo;<a href={m.url} target="_blank" rel="noopener">{m.title}</a>&rdquo; by{' '}
				<a href={m.authorUrl} target="_blank" rel="noopener">{m.author}</a>,{' '}
				<a href={LICENSE_URL} target="_blank" rel="noopener">CC BY 4.0</a>. {m.changes}
				{m.noun ? ` Illustration only; your ${m.noun} will differ.` : ''}
			</p>
		)
	}
</div>

<style is:global>
.m3d { min-width: 0; }
.m3d-frame { position: relative; width: 100%; aspect-ratio: var(--ratio, 1); max-height: 78vh; margin-inline: auto; }
.m3d-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .5s ease; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, .35)); }
.m3d model-viewer { position: absolute; inset: 0; width: 100%; height: 100%; background: transparent; --poster-color: transparent; --progress-bar-color: var(--color-accent, #4bdcea); --progress-bar-height: 3px; outline: none; opacity: 0; transition: opacity .5s ease; cursor: grab; }
.m3d model-viewer:active { cursor: grabbing; }
.m3d.is-ready model-viewer { opacity: 1; }
.m3d.is-ready .m3d-poster { opacity: 0; pointer-events: none; }
.m3d.is-failed model-viewer { display: none; }
.m3d-hint { position: absolute; left: 50%; bottom: .25rem; translate: -50% 0; padding: .3rem .7rem; border-radius: 99px; background: var(--color-paper-2, #101c26); border: 1px solid var(--color-rule-hi, #29404f); color: var(--color-muted, #8fa5b3); font-size: .72rem; pointer-events: none; opacity: 0; transition: opacity .4s; }
.m3d.is-ready .m3d-hint { opacity: 1; }
.m3d.is-ready.has-moved .m3d-hint { opacity: 0; }
.m3d-load { position: absolute; left: 50%; bottom: 8%; translate: -50% 0; min-height: 44px; padding: .6rem 1.1rem; border-radius: 6px; border: 1px solid var(--color-accent, #4bdcea); background: var(--color-paper-2, #101c26); color: var(--color-ink, #fff); font: 600 .85rem var(--font-body, sans-serif); cursor: pointer; }
.m3d-load[hidden] { display: none; }
.m3d.is-loading .m3d-poster { animation: m3d-pulse 1.4s ease-in-out infinite; }
.m3d-credit { margin: .6rem 0 0; color: var(--color-muted, #8fa5b3); font-size: .72rem; line-height: 1.5; }
.m3d-credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
.m3d-credit a:hover { color: var(--color-accent, #4bdcea); }
@keyframes m3d-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .6; } }
@media (prefers-reduced-motion: reduce) { .m3d.is-loading .m3d-poster { animation: none; } }
</style>

<script>
	let viewerReady: Promise<void> | null = null;
	function loadViewer(): Promise<void> {
		viewerReady ??= import('@google/model-viewer')
			.then(() => customElements.whenDefined('model-viewer'))
			.then((C: any) => {
				C.meshoptDecoderLocation = new URL('/models/meshopt_decoder.js', location.href).href;
			});
		return viewerReady;
	}

	const reduce = matchMedia('(prefers-reduced-motion: reduce)');
	const motionOn = () => !reduce.matches && document.documentElement.dataset.motion !== 'paused';
	const mounted = new Set<HTMLElement>();
	const syncRotate = () => mounted.forEach((mv) => (motionOn() ? mv.setAttribute('auto-rotate', '') : mv.removeAttribute('auto-rotate')));
	reduce.addEventListener('change', syncRotate);
	new MutationObserver(syncRotate).observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] });

	function mount(root: HTMLElement) {
		if (root.dataset.mounted) return;
		root.dataset.mounted = '1';
		root.classList.add('is-loading');
		const frame = root.querySelector('.m3d-frame') as HTMLElement;
		const fail = () => {
			root.classList.remove('is-loading');
			root.classList.add('is-failed');
		};
		loadViewer()
			.then(() => {
				const mv = document.createElement('model-viewer');
				const set = (k: string, v = '') => mv.setAttribute(k, v);
				set('src', root.dataset.src!);
				set('alt', root.dataset.label || '3D model');
				set('camera-controls');
				set('camera-orbit', root.dataset.orbit || '0deg 75deg auto');
				set('min-camera-orbit', 'auto 20deg auto');
				set('max-camera-orbit', 'auto 110deg auto');
				set('field-of-view', '28deg');
				set('disable-zoom');
				set('disable-pan');
				set('touch-action', 'pan-y');
				set('interaction-prompt', 'none');
				set('shadow-intensity', '1.1');
				set('shadow-softness', '1');
				set('environment-image', 'neutral');
				set('exposure', '1.15');
				set('rotation-per-second', '14deg');
				set('auto-rotate-delay', '2500');
				if (motionOn()) set('auto-rotate');
				mv.addEventListener('load', () => {
					root.classList.remove('is-loading');
					root.classList.add('is-ready');
					root.querySelector('.m3d-poster')?.setAttribute('aria-hidden', 'true');
				});
				mv.addEventListener('camera-change', (e: any) => {
					if (e.detail?.source === 'user-interaction') root.classList.add('has-moved');
				});
				mv.addEventListener('error', fail);
				frame.prepend(mv);
				mounted.add(mv);
			})
			.catch(fail);
	}

	const saveData = Boolean((navigator as any).connection?.saveData);
	const io =
		'IntersectionObserver' in window
			? new IntersectionObserver(
					(entries) =>
						entries.forEach((en) => {
							if (!en.isIntersecting) return;
							io!.unobserve(en.target);
							mount(en.target as HTMLElement);
						}),
					{ rootMargin: '300px' }
				)
			: null;

	const whenIdle = (fn: () => void) => {
		const go = () => ((window as any).requestIdleCallback ? (window as any).requestIdleCallback(fn, { timeout: 3000 }) : setTimeout(fn, 1200));
		document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
	};

	document.querySelectorAll<HTMLElement>('[data-model3d]').forEach((root) => {
		if (saveData) {
			const btn = root.querySelector<HTMLButtonElement>('.m3d-load');
			if (btn) {
				btn.hidden = false;
				btn.addEventListener('click', () => {
					btn.hidden = true;
					mount(root);
				});
			}
		} else if (root.dataset.priority) whenIdle(() => mount(root));
		else if (io) io.observe(root);
		else mount(root);
	});
</script>
