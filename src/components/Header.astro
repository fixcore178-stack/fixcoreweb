---
import { SITE_TITLE, WHATSAPP_URL } from '../consts';

const path = Astro.url.pathname;
---

<header>
	<div class="wrap bar">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<img src="/logo-mark.png" width="44" height="45" alt="" />
			<span class="word">
				<span class="name">FixCore</span>
				<span class="sub">TECH</span>
			</span>
		</a>
		<nav aria-label="Main">
			<a class="opt" href="/#repairs">Repairs</a>
			<a class="opt" href="/#faq">FAQ</a>
			<a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
			<a class="btn btn-wa cta" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp us</a>
		</nav>
	</div>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--navy);
	}
	.brand img {
		display: block;
		width: 2.75rem;
		height: auto;
	}
	.word {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}
	.name {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.55rem;
		letter-spacing: -0.04em;
	}
	.sub {
		margin-top: 0.3rem;
		font-family: var(--display);
		font-weight: 600;
		font-size: 0.7rem;
		letter-spacing: 0.5em;
		color: var(--blue);
	}
	.brand:hover {
		color: var(--navy);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-weight: 500;
	}
	nav a:not(.btn) {
		padding-block: 0.5rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	nav a:not(.btn):hover {
		border-bottom-color: var(--blue);
	}
	nav a[aria-current='page'] {
		border-bottom-color: var(--blue);
	}
	.cta {
		min-height: 2.6rem;
		padding-inline: 1.1rem;
		font-size: 0.95rem;
	}
	@media (max-width: 640px) {
		.opt {
			display: none;
		}
		nav {
			gap: 1rem;
		}
		.brand img {
			width: 2.25rem;
		}
		.name {
			font-size: 1.3rem;
		}
	}
</style>
