---
import { SITE_TITLE, socials } from '../consts';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// `section` links scroll on the landing page; `path` marks the matching page as current.
const links = [
	{ href: '/#services', label: 'Services', section: 'services', path: '/services' },
	{ href: '/pricing', label: 'Pricing', path: '/pricing' },
	{ href: '/#process', label: 'How it works', section: 'process' },
	{ href: '/about', label: 'About', path: '/about' },
	{ href: '/#faq', label: 'FAQ', section: 'faq' },
	{ href: '/#contact', label: 'Contact', section: 'contact' },
];

const isCurrent = (p?: string) => !!p && (path === p || path.startsWith(p + '/'));
---

<header class="nav-wrap" data-nav>
	<div class="wrap">
		<div class="nav glass">
			<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
				<span class="mark">
					<img src="/logo-mark.png" width="76" height="77" alt="" decoding="async" />
				</span>
				<span class="word">
					<span class="name">FixCore</span>
					<span class="sub">TECH</span>
				</span>
			</a>

			<nav class="links" aria-label="Main" data-links>
				<span class="indicator" aria-hidden="true"></span>
				{
					links.map((l) => (
						<a
							href={l.href}
							data-section={l.section}
							data-path={l.path}
							aria-current={isCurrent(l.path) ? 'page' : undefined}
						>
							{l.label}
						</a>
					))
				}
			</nav>

			<div class="actions">
				<button class="theme" type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-toggle>
					<span class="theme-track">
						<Icon class="t-sun" name="sun" size={14} stroke={2} />
						<Icon class="t-moon" name="moon" size={14} stroke={2} />
						<span class="theme-thumb"></span>
					</span>
				</button>
				<a class="btn btn-primary btn-sm cta" href="/#quote">
					<span>Get a quote</span>
					<Icon class="arrow" name="arrow" size={16} stroke={2.2} />
				</a>
				<button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
					<span class="bars" aria-hidden="true"><i></i><i></i></span>
				</button>
			</div>
		</div>
	</div>

	<div class="sheet" id="mobile-menu" data-sheet inert>
		<div class="wrap">
			<nav class="sheet-in glass" aria-label="Mobile">
				{
					links.map((l, i) => (
						<a href={l.href} style={`--i:${i}`} aria-current={isCurrent(l.path) ? 'page' : undefined}>
							{l.label}
							<Icon name="arrow" size={18} />
						</a>
					))
				}
				<a class="btn btn-primary sheet-cta" style={`--i:${links.length}`} href="/#quote">Get a repair quote</a>
				<ul class="sheet-social" style={`--i:${links.length + 1}`}>
					{
						socials.map((s) => (
							<li>
								<a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label} ${s.handle}`}>
									<BrandIcon name={s.name} size={20} />
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</header>

<style>
	.nav-wrap {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 50;
		padding-top: 0.9rem;
		transition: padding 0.4s var(--ease);
		pointer-events: none;
	}
	.nav-wrap :global(.nav),
	.nav-wrap :global(.sheet-in) {
		pointer-events: auto;
	}
	.nav-wrap.scrolled {
		padding-top: 0.5rem;
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4rem;
		padding: 0.4rem 0.6rem 0.4rem 0.9rem;
		border-radius: 999px;
		transition:
			background-color 0.4s,
			box-shadow 0.4s,
			min-height 0.4s var(--ease);
	}
	.scrolled .nav {
		min-height: 3.5rem;
		background: color-mix(in srgb, var(--glass-solid) 72%, transparent);
		box-shadow:
			0 18px 50px rgb(0 0 0 / 0.35),
			inset 0 1px 0 var(--hi);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--ink);
		text-decoration: none;
	}
	.brand:hover {
		color: var(--ink);
	}
	/* The logo is navy on transparent, so it sits on a light tile that works on dark glass */
	.mark {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 12px;
		background: linear-gradient(160deg, #fff, #dbe8fb);
		box-shadow:
			0 0 0 1px rgb(255 255 255 / 0.5),
			0 6px 18px rgb(47 123 255 / 0.35);
		transition: transform 0.4s var(--ease);
	}
	.brand:hover .mark {
		transform: rotate(-6deg) scale(1.06);
	}
	.mark img {
		display: block;
		width: 1.85rem;
		height: auto;
	}
	.word {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}
	.name {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.3rem;
		letter-spacing: -0.045em;
	}
	.sub {
		margin-top: 0.28rem;
		font-family: var(--display);
		font-weight: 600;
		font-size: 0.6rem;
		letter-spacing: 0.55em;
		color: var(--cyan);
	}

	.links {
		position: relative;
		display: none;
		align-items: center;
		gap: 0.1rem;
	}
	.links a {
		position: relative;
		z-index: 1;
		padding: 0.55rem 0.95rem;
		border-radius: 999px;
		color: var(--ink-2);
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.2s;
	}
	.links a:hover,
	.links a.active,
	.links a[aria-current='page'] {
		color: var(--ink);
	}
	/* Sliding pill that follows the current section */
	.indicator {
		position: absolute;
		top: 50%;
		left: 0;
		height: 2.35rem;
		width: var(--iw, 0px);
		border-radius: 999px;
		background: var(--glass-hi);
		box-shadow:
			inset 0 0 0 1px var(--stroke-hi),
			inset 0 1px 0 var(--hi),
			0 6px 20px color-mix(in srgb, var(--blue-strong) 25%, transparent);
		transform: translate3d(var(--ix, 0px), -50%, 0);
		opacity: 0;
		transition:
			transform 0.5s var(--ease),
			width 0.5s var(--ease),
			opacity 0.3s;
	}
	.indicator.on {
		opacity: 1;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.cta {
		display: none;
	}

	.theme {
		flex: none;
		padding: 0.3rem 0;
		border: 0;
		background: none;
		color: var(--ink);
		cursor: pointer;
	}
	.theme-track {
		position: relative;
		display: block;
		width: 3.3rem;
		height: 1.9rem;
		border-radius: 999px;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		transition: box-shadow 0.2s;
	}
	.theme:hover .theme-track {
		box-shadow: inset 0 0 0 1px var(--stroke-hi);
	}
	.theme:focus-visible {
		border-radius: 999px;
	}
	.theme :global(.t-sun),
	.theme :global(.t-moon) {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		color: var(--muted);
	}
	.theme :global(.t-sun) {
		left: 0.55rem;
	}
	.theme :global(.t-moon) {
		right: 0.55rem;
	}
	.theme-thumb {
		position: absolute;
		top: 50%;
		left: 0.22rem;
		width: 1.45rem;
		height: 1.45rem;
		border-radius: 50%;
		background: var(--accent-grad);
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
		transform: translate3d(0, -50%, 0);
		transition: transform 0.45s var(--ease);
	}
	.theme[aria-checked='true'] .theme-thumb {
		transform: translate3d(1.4rem, -50%, 0);
	}
	.theme[aria-checked='true'] :global(.t-moon),
	.theme[aria-checked='false'] :global(.t-sun) {
		opacity: 0;
	}

	.burger {
		display: grid;
		place-items: center;
		width: 2.8rem;
		height: 2.8rem;
		border: 0;
		border-radius: 50%;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		color: var(--ink);
		cursor: pointer;
	}
	.bars {
		position: relative;
		width: 1.15rem;
		height: 0.75rem;
	}
	.bars i {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition:
			transform 0.4s var(--ease),
			top 0.4s var(--ease);
	}
	.bars i:first-child {
		top: 0;
	}
	.bars i:last-child {
		top: calc(100% - 2px);
	}
	.burger[aria-expanded='true'] .bars i:first-child {
		top: calc(50% - 1px);
		transform: rotate(45deg);
	}
	.burger[aria-expanded='true'] .bars i:last-child {
		top: calc(50% - 1px);
		transform: rotate(-45deg);
	}

	/* Mobile sheet */
	.sheet {
		position: absolute;
		inset: 100% 0 auto 0;
		padding-top: 0.5rem;
		visibility: hidden;
		opacity: 0;
		transform: translateY(-10px) scale(0.98);
		transform-origin: top center;
		transition:
			opacity 0.35s var(--ease),
			transform 0.45s var(--ease),
			visibility 0s 0.45s;
	}
	.sheet.open {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition-delay: 0s;
	}
	.sheet-in {
		display: grid;
		gap: 0.25rem;
		padding: 0.7rem;
		background: color-mix(in srgb, var(--glass-solid) 88%, transparent);
	}
	.sheet-in > a:not(.btn) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.95rem 1rem;
		border-radius: 14px;
		color: var(--ink);
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.sheet-in > a:not(.btn):hover,
	.sheet-in > a[aria-current='page'] {
		background: var(--glass-hi);
	}
	.sheet-in > a :global(svg) {
		color: var(--muted);
	}
	.sheet.open .sheet-in > * {
		animation: sheet-item 0.55s var(--ease) both;
		animation-delay: calc(var(--i, 0) * 45ms + 80ms);
	}
	.sheet-cta {
		margin-top: 0.4rem;
	}
	.sheet-social {
		display: flex;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.7rem 0 0.3rem;
	}
	.sheet-social a {
		display: grid;
		place-items: center;
		width: 2.8rem;
		height: 2.8rem;
		border-radius: 50%;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		color: var(--ink);
		transition:
			background-color 0.2s,
			transform 0.3s var(--ease);
	}
	.sheet-social a:hover {
		background: var(--glass-hi);
		color: var(--cyan);
		transform: translateY(-2px);
	}
	@keyframes sheet-item {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}

	@media (min-width: 1020px) {
		.links {
			display: flex;
		}
		.cta {
			display: inline-flex;
		}
		.burger,
		.sheet {
			display: none;
		}
	}
	@media (max-width: 420px) {
		.theme-track {
			width: 3rem;
		}
		.theme[aria-checked='true'] .theme-thumb {
			transform: translate3d(1.15rem, -50%, 0);
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-nav]');
	const linksEl = document.querySelector<HTMLElement>('[data-links]');
	const indicator = linksEl?.querySelector<HTMLElement>('.indicator');
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
	const sheet = document.querySelector<HTMLElement>('[data-sheet]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;

	/* ----- Scroll state: the navbar condenses and gains depth ----- */
	const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 16);
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	/* ----- Active section indicator ----- */
	const anchors = Array.from(linksEl?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
	const sectionLinks = anchors.filter((a) => a.dataset.section);
	const onHome = location.pathname === '/' || location.pathname === '';
	let current: HTMLAnchorElement | null = anchors.find((a) => a.getAttribute('aria-current') === 'page') ?? null;

	const place = (link: HTMLAnchorElement | null) => {
		if (!indicator || !linksEl) return;
		anchors.forEach((a) => a.classList.toggle('active', a === link));
		if (!link) {
			indicator.classList.remove('on');
			return;
		}
		indicator.style.setProperty('--ix', `${link.offsetLeft}px`);
		indicator.style.setProperty('--iw', `${link.offsetWidth}px`);
		indicator.classList.add('on');
	};
	place(current);

	if (onHome && sectionLinks.length) {
		const ids = sectionLinks.map((a) => a.dataset.section as string);
		const spy = () => {
			// The section whose top has passed 40% of the viewport and which is still on screen
			const line = window.innerHeight * 0.4;
			let active: string | null = null;
			for (const id of ids) {
				const el = document.getElementById(id);
				if (!el) continue;
				const r = el.getBoundingClientRect();
				if (r.top <= line && r.bottom > line) active = id;
			}
			const next = sectionLinks.find((a) => a.dataset.section === active) ?? null;
			if (next !== current) {
				current = next;
				place(current);
			}
		};
		spy();
		window.addEventListener('scroll', spy, { passive: true });
		window.addEventListener('resize', spy);
	}
	if (linksEl && 'ResizeObserver' in window) {
		new ResizeObserver(() => place(current)).observe(linksEl);
	}
	document.fonts?.ready.then(() => place(current));

	/* ----- Mobile menu ----- */
	let open = false;
	const setMenu = (next: boolean, returnFocus = true) => {
		if (!burger || !sheet) return;
		open = next;
		burger.setAttribute('aria-expanded', String(next));
		burger.setAttribute('aria-label', next ? 'Close menu' : 'Open menu');
		sheet.classList.toggle('open', next);
		if (next) sheet.removeAttribute('inert');
		else sheet.setAttribute('inert', '');
		document.dispatchEvent(new CustomEvent('fx:lock', { detail: next }));
		if (next) sheet.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
		else if (returnFocus) burger.focus({ preventScroll: true });
	};
	burger?.addEventListener('click', () => setMenu(!open));
	sheet?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) setMenu(false, false);
	});
	document.addEventListener('keydown', (e) => {
		if (!open) return;
		if (e.key === 'Escape') setMenu(false);
		if (e.key === 'Tab' && burger && sheet) {
			// Keep Tab inside the menu button and the open sheet
			const items = [burger, ...Array.from(sheet.querySelectorAll<HTMLElement>('a'))];
			const first = items[0];
			const last = items[items.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}
	});
	window.matchMedia('(min-width: 1020px)').addEventListener('change', (m) => {
		if (m.matches && open) setMenu(false, false);
	});

	/* ----- Theme switch ----- */
	const syncToggle = () => toggle?.setAttribute('aria-checked', String(root.getAttribute('data-theme') === 'dark'));
	syncToggle();
	toggle?.addEventListener('click', () => {
		const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
		document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#eaf1fb' : '#05080f');
		syncToggle();
	});
</script>
