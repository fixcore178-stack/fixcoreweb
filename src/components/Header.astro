---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, WHATSAPP_URL } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a class="cta" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp us</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		max-width: 1000px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		font-size: 1.4em;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		text-decoration: none;
		padding: 0.6em 0;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.links :global(a) {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	.links :global(a.active) {
		border-bottom-color: var(--accent);
	}
	.links a.cta {
		background: #25d366;
		color: #06311a;
		font-weight: 700;
		padding: 0.4em 0.9em;
		border-radius: 999px;
		border-bottom: none;
		margin-left: 0.5em;
	}
	@media (max-width: 520px) {
		.links :global(a:not(.cta)) {
			padding: 1em 0.3em;
			font-size: 0.9em;
		}
		.links a.cta {
			font-size: 0.85em;
		}
	}
</style>
