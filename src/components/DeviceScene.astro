<style>
.device-study { margin:0; min-width:0; border-block:1px solid var(--color-rule-hi); }
.study-top { display:flex; justify-content:space-between; gap:1rem; padding:1rem 0; color:var(--color-muted); font-size:.78rem; }.study-top span:first-child { color:var(--color-ink); font-weight:600; }
.assembly svg { display:block; width:100%; height:auto; overflow:visible; }.assembly { overflow:hidden; }.phone-object { animation:phone-hover 9s ease-in-out infinite; }.phone-board { animation:board-separation 9s ease-in-out infinite; }.phone-front { animation:screen-separation 9s ease-in-out infinite; }
.parts { display:flex; justify-content:space-between; gap:.75rem; border-top:1px solid var(--color-rule); padding:1rem 0 .5rem; color:var(--color-ink-2); font-size:.83rem; }figcaption { padding:0 0 1rem; color:var(--color-muted); font-size:.78rem; }
@keyframes phone-hover { 0%,100% { transform:translateY(3px); } 50% { transform:translateY(-3px); } }
@keyframes board-separation { 0%,100% { transform:translate(0,0); } 50% { transform:translate(-6px,-9px); } }
@keyframes screen-separation { 0%,100% { transform:translate(0,0); } 50% { transform:translate(-14px,-20px); } }
@media(prefers-reduced-motion:reduce) { .phone-object,.phone-board,.phone-front { animation:none; } }
</style>
