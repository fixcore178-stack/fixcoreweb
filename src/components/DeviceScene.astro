---
// Hero visual: a floating, 3D-inspired laptop and phone built from layered glass.
// Pure HTML and CSS, sized with container units so it scales cleanly. Decorative only.
import Icon from './Icon.astro';
---

<div class="host" data-scene-host aria-hidden="true">
	<div class="scene" data-scene>
		<div class="stage">
			<div class="halo"></div>
			<div class="floor"></div>

			<div class="laptop" data-parallax="0.05">
				<div class="screen glass">
					<div class="bar">
						<i></i><i></i><i></i>
						<span class="bar-title">Device check</span>
					</div>
					<div class="body">
						<div class="shield">
							<svg viewBox="0 0 64 72" fill="none">
								<defs>
									<linearGradient id="sg" x1="0" y1="0" x2="1" y2="1">
										<stop offset="0" stop-color="#7fe3ff" />
										<stop offset="1" stop-color="#3b82ff" />
									</linearGradient>
								</defs>
								<path d="M32 4 56 12v22c0 17-10 28-24 34C18 62 8 51 8 34V12z" stroke="url(#sg)" stroke-width="3" fill="rgb(59 130 255 / .12)" />
								<rect x="20" y="22" width="24" height="17" rx="2.5" stroke="url(#sg)" stroke-width="2.4" />
								<path d="M27 46h10" stroke="url(#sg)" stroke-width="2.4" stroke-linecap="round" />
								<path d="m27 31 4 4 7-8" stroke="#7fe3ff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span class="ring"></span>
						</div>
						<ul class="rows">
							<li><span>Screen</span><b class="r1"></b></li>
							<li><span>Battery</span><b class="r2"></b></li>
							<li><span>Charging port</span><b class="r3"></b></li>
						</ul>
					</div>
				</div>
				<div class="hinge"></div>
				<div class="base"></div>
			</div>

			<div class="phone" data-parallax="-0.06">
				<div class="phone-in glass">
					<span class="notch"></span>
					<div class="chat">
						<span class="bubble out">Hi FixCore Tech! My phone has a cracked screen.</span>
						<span class="bubble in">Send us the model and a photo and we will quote it.</span>
						<span class="bubble out short">iPhone 13</span>
						<span class="typing"><i></i><i></i><i></i></span>
					</div>
				</div>
			</div>

			<div class="chip c1"><Icon name="wrench" size={18} stroke={2} /><span>Screen</span></div>
			<div class="chip c2"><Icon name="battery" size={18} stroke={2} /><span>Battery</span></div>
			<div class="chip c3"><Icon name="check" size={18} stroke={2.4} /><span>Quote first</span></div>
		</div>
	</div>
</div>

<style>
	.host {
		container-type: inline-size;
		width: 100%;
		max-width: 620px;
		margin-inline: auto;
	}
	.scene {
		position: relative;
		width: 100%;
		aspect-ratio: 1 / 0.92;
		perspective: 1600px;
		--srx: 0deg;
		--sry: 0deg;
	}
	.stage {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transform: rotateX(var(--srx)) rotateY(var(--sry));
		transition: transform 0.8s var(--ease);
	}

	.halo {
		position: absolute;
		left: 50%;
		top: 46%;
		width: 82cqw;
		height: 82cqw;
		translate: -50% -50%;
		border-radius: 50%;
		background:
			radial-gradient(circle at 35% 35%, var(--orb-a), transparent 60%),
			radial-gradient(circle at 70% 65%, var(--orb-b), transparent 62%);
		filter: blur(34px);
		opacity: 0.9;
	}
	.floor {
		position: absolute;
		left: 8cqw;
		right: 8cqw;
		bottom: 5cqw;
		height: 9cqw;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(0 0 0 / 0.5), transparent);
		filter: blur(10px);
	}

	/* Laptop */
	.laptop {
		position: absolute;
		left: 1cqw;
		top: 9cqw;
		width: 78cqw;
		translate: 0 var(--py, 0);
		transform: translateZ(0) rotateY(-12deg) rotateX(4deg);
		transform-style: preserve-3d;
		animation: bob 9s ease-in-out infinite;
	}
	.screen {
		aspect-ratio: 16 / 10.2;
		border-radius: 2.6cqw 2.6cqw 1cqw 1cqw;
		padding: 2cqw;
		display: flex;
		flex-direction: column;
		gap: 1.6cqw;
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--blue-strong) 34%, transparent), rgb(255 255 255 / 0.05) 70%),
			var(--glass);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 0.8cqw;
	}
	.bar i {
		width: 1.3cqw;
		height: 1.3cqw;
		border-radius: 50%;
		background: var(--stroke-hi);
	}
	.bar-title {
		margin-left: 1.2cqw;
		font-size: 1.9cqw;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.body {
		flex: 1;
		display: grid;
		grid-template-columns: 0.9fr 1.3fr;
		align-items: center;
		gap: 3cqw;
		padding: 1cqw 2cqw 1cqw;
	}
	.shield {
		position: relative;
		display: grid;
		place-items: center;
	}
	.shield svg {
		width: 15cqw;
		height: auto;
		filter: drop-shadow(0 0 2cqw rgb(91 160 255 / 0.55));
	}
	.ring {
		position: absolute;
		inset: -2.2cqw;
		border-radius: 50%;
		border: 1px dashed var(--stroke-hi);
		animation: spin 24s linear infinite;
	}
	.rows {
		display: grid;
		gap: 2cqw;
	}
	.rows li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2cqw;
		font-size: 2cqw;
		color: var(--ink-2);
	}
	.rows b {
		position: relative;
		flex: 0 0 38%;
		height: 0.9cqw;
		border-radius: 99px;
		background: var(--stroke);
		overflow: hidden;
	}
	.rows b::after {
		content: '';
		position: absolute;
		inset: 0;
		width: var(--w);
		border-radius: inherit;
		background: var(--accent-grad);
		transform-origin: left;
		animation: fill 5s var(--ease) infinite;
	}
	.r1 {
		--w: 92%;
	}
	.r2 {
		--w: 68%;
	}
	.r3 {
		--w: 80%;
	}
	.r2::after {
		animation-delay: 0.3s;
	}
	.r3::after {
		animation-delay: 0.6s;
	}
	.hinge {
		height: 0.8cqw;
		margin-inline: 1.5%;
		background: linear-gradient(180deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.06));
	}
	.base {
		height: 2.2cqw;
		margin-inline: -4%;
		border-radius: 0 0 2.4cqw 2.4cqw / 0 0 2cqw 2cqw;
		background: linear-gradient(180deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.05));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.4),
			0 2cqw 5cqw rgb(0 0 0 / 0.45);
	}

	/* Phone */
	.phone {
		position: absolute;
		right: 3cqw;
		bottom: 3cqw;
		width: 27cqw;
		aspect-ratio: 9 / 18.5;
		translate: 0 var(--py, 0);
		transform: translateZ(70px) rotateY(-12deg) rotateX(4deg) rotateZ(3deg);
		transform-style: preserve-3d;
		animation: bob 7s ease-in-out -2s infinite;
	}
	.phone-in {
		height: 100%;
		border-radius: 5cqw;
		padding: 2.2cqw;
		background:
			linear-gradient(170deg, color-mix(in srgb, var(--violet) 26%, transparent), color-mix(in srgb, var(--blue-strong) 14%, transparent) 60%),
			var(--glass);
		box-shadow:
			0 3cqw 7cqw rgb(0 0 0 / 0.5),
			inset 0 1px 0 rgb(255 255 255 / 0.4);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
	}
	.notch {
		display: block;
		width: 7cqw;
		height: 1.5cqw;
		margin: 0 auto 2cqw;
		border-radius: 99px;
		background: rgb(0 0 0 / 0.55);
	}
	.chat {
		display: grid;
		gap: 1.4cqw;
		align-content: start;
	}
	.bubble {
		max-width: 88%;
		padding: 1.4cqw 1.7cqw;
		border-radius: 2cqw;
		font-size: 1.75cqw;
		line-height: 1.35;
		animation: pop 0.8s var(--ease) both;
	}
	.bubble.out {
		justify-self: end;
		border-bottom-right-radius: 0.6cqw;
		background: var(--accent-grad);
		color: var(--on-accent);
		animation-delay: 0.6s;
	}
	.bubble.in {
		justify-self: start;
		border-bottom-left-radius: 0.6cqw;
		background: var(--glass-hi);
		color: var(--ink);
		box-shadow: inset 0 0 0 1px var(--stroke);
		animation-delay: 1.3s;
	}
	.bubble.short {
		animation-delay: 2s;
	}
	.typing {
		justify-self: start;
		display: flex;
		gap: 0.7cqw;
		padding: 1.5cqw 1.8cqw;
		border-radius: 2cqw;
		background: var(--glass-hi);
		animation: pop 0.8s var(--ease) 2.7s both;
	}
	.typing i {
		width: 1cqw;
		height: 1cqw;
		border-radius: 50%;
		background: var(--muted);
		animation: dot 1.2s ease-in-out infinite;
	}
	.typing i:nth-child(2) {
		animation-delay: 0.15s;
	}
	.typing i:nth-child(3) {
		animation-delay: 0.3s;
	}

	/* Floating chips */
	.chip {
		position: absolute;
		display: inline-flex;
		align-items: center;
		gap: 1.1cqw;
		padding: 1.3cqw 2.2cqw 1.3cqw 1.6cqw;
		border-radius: 99px;
		background: color-mix(in srgb, var(--glass-solid) 70%, transparent);
		box-shadow:
			inset 0 0 0 1px var(--stroke-hi),
			0 1.6cqw 4cqw rgb(0 0 0 / 0.35);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		font-size: 2.2cqw;
		font-weight: 600;
		color: var(--ink);
		transform: translateZ(110px);
	}
	.chip :global(svg) {
		width: 2.7cqw;
		height: 2.7cqw;
		color: var(--cyan);
	}
	.c1 {
		left: 0;
		top: 3cqw;
		animation: bob 6s ease-in-out -1s infinite;
	}
	.c2 {
		right: 1cqw;
		top: 12cqw;
		animation: bob 8s ease-in-out -3s infinite;
	}
	.c3 {
		left: 6cqw;
		bottom: 4cqw;
		animation: bob 7s ease-in-out -4s infinite;
	}

	/* Float on the compositor: the parallax offset (--py) is folded into the keyframes */
	@keyframes bob {
		0%,
		100% {
			translate: 0 var(--py, 0px);
		}
		50% {
			translate: 0 calc(var(--py, 0px) - 1.6cqw);
		}
	}
	@keyframes spin {
		to {
			rotate: 360deg;
		}
	}
	@keyframes fill {
		0% {
			transform: scaleX(0);
		}
		40%,
		85% {
			transform: scaleX(1);
		}
		100% {
			transform: scaleX(1);
			opacity: 0.4;
		}
	}
	@keyframes pop {
		from {
			opacity: 0;
			transform: translateY(1.5cqw) scale(0.96);
		}
	}
	@keyframes dot {
		50% {
			opacity: 0.35;
			transform: translateY(-0.5cqw);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.laptop,
		.phone,
		.chip,
		.ring,
		.rows b::after {
			animation: none;
		}
	}
</style>
