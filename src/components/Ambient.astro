---
// Background: flat paper with a fine measured grid that fades out toward the bottom.
// Decorative only; it is a single CSS layer with no animation.
---

<div class="ambient" aria-hidden="true"></div>

<style>
	.ambient {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background-color: var(--color-paper);
		background-image:
			linear-gradient(var(--color-rule) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-rule) 1px, transparent 1px);
		background-size: 56px 56px;
		background-position: -1px -1px;
		-webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
		mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
	}
</style>
