<figure class="laptop-study">
  <div class="rig" data-motion-scene>
    <svg viewBox="0 0 560 480" role="img" aria-label="Three-dimensional laptop cutaway with aligned keyboard, cooling fans, motherboard and battery">
      <defs>
        <linearGradient id="laptop-metal" x2=".8" y2="1"><stop stop-color="#dce4e8"/><stop offset=".48" stop-color="#9dAFba"/><stop offset="1" stop-color="#677f8f"/></linearGradient>
        <linearGradient id="laptop-rim" x2="0" y2="1"><stop stop-color="#8fa5b3"/><stop offset="1" stop-color="#304b5e"/></linearGradient>
        <linearGradient id="laptop-glass" x2=".8" y2="1"><stop stop-color="#153b4e"/><stop offset="1" stop-color="#071c2a"/></linearGradient>
        <linearGradient id="laptop-wave" x2="1" y2="1"><stop stop-color="#c4eff0"/><stop offset=".5" stop-color="#57bccb"/><stop offset="1" stop-color="#26738d"/></linearGradient>
        <clipPath id="laptop-screen-clip"><rect x="9" y="10" width="282" height="180" rx="5"/></clipPath>
      </defs>
      <ellipse cx="295" cy="416" rx="172" ry="20" fill="#000" opacity=".12"/>
      <g class="laptop-object">
        <g transform="matrix(.94 .13 -.05 .85 100 37)">
          <rect x="-3" y="-3" width="306" height="211" rx="10" fill="#263e4e" stroke="#9db3bf" stroke-width="2"/>
          <rect width="300" height="205" rx="8" fill="url(#laptop-rim)" stroke="#c5d2db" stroke-width="1.5"/>
          <rect x="6" y="6" width="288" height="190" rx="6" fill="#0b1c28"/>
          <g clip-path="url(#laptop-screen-clip)">
            <rect x="9" y="10" width="282" height="180" fill="url(#laptop-glass)"/>
            <path d="M-30 175C52 207 103 51 328 25" stroke="url(#laptop-wave)" stroke-width="60" fill="none"/>
            <path d="M-17 224C105 262 196 99 330 123" stroke="#286c83" stroke-width="34" fill="none"/>
            <path d="M9 10h282v70L9 35Z" fill="#ecfaff" opacity=".05"/>
          </g>
          <circle cx="150" cy="5" r="1.8" fill="#091825"/>
          <path d="M128 201h44" stroke="#627b8b" stroke-width="1.5"/>
        </g>
        <g transform="matrix(.94 .13 .64 .74 90 230)">
          <rect y="10" width="300" height="166" rx="10" fill="#304b5c" stroke="#718b9c" stroke-width="2"/>
          <rect width="300" height="166" rx="10" fill="url(#laptop-metal)" stroke="#ccdae2" stroke-width="2"/>
          <rect x="8" y="8" width="284" height="149" rx="5" fill="#294d4b" stroke="#7e9895"/>
          <rect x="103" y="23" width="70" height="48" rx="3" fill="#536c76" stroke="#a5bac3" stroke-width="3"/>
          <rect x="119" y="33" width="38" height="28" rx="2" fill="#7f9aa7"/>
          <path d="M130 71v16h110V58" stroke="#ac9576" stroke-width="7" stroke-linejoin="round" fill="none"/>
          {[51,247].map(x=><g transform={`translate(${x} 46)`}><circle r="31" fill="#173039" stroke="#718e98" stroke-width="3"/><g class="cooling-fan">{Array.from({length:10},(_,i)=><path d="M-3-5C-20-21-4-29 3-24L6-8Z" fill="#88a6b0" transform={`rotate(${i*36})`}/>)}</g><circle r="7" fill="#b4c8d1" stroke="#3b5968" stroke-width="2"/></g>)}
          <rect x="21" y="106" width="257" height="38" rx="4" fill="#263c49" stroke="#738f9f"/>
          <path d="M106 110v30m86-30v30" stroke="#5b788a"/>
          <rect x="100" y="89" width="104" height="9" rx="1" fill="#8caa98"/>
          <path d="M114 91v5m13-5v5m13-5v5m13-5v5m13-5v5m13-5v5" stroke="#1f373f" stroke-width="6"/>
          <path d="M124 173h52" stroke="#1a303e" stroke-width="3" stroke-linecap="round"/>
        </g>
        <g class="keyboard-lift">
          <g transform="matrix(.94 .13 .64 .74 90 187)">
            <rect y="5" width="300" height="166" rx="9" fill="#415e70" stroke="#7d96a6"/>
            <rect width="300" height="166" rx="9" fill="url(#laptop-metal)" stroke="#d5e0e7" stroke-width="1.5"/>
            <rect x="13" y="12" width="274" height="92" rx="5" fill="#6b8493"/>
            {Array.from({length:5},(_,row)=>Array.from({length:12},(_,col)=><rect x={18+col*22} y={17+row*17} width="18" height="13" rx="2" fill="#233d4f" stroke="#91a7b4" stroke-width=".5"/>))}
            <rect x="86" y="110" width="127" height="41" rx="5" fill="#a7b9c3" stroke="#647f90"/>
            <path d="M22 115v29m5-29v29m5-29v29m236-29v29m5-29v29m5-29v29" stroke="#718a9a" stroke-width="1.5" stroke-dasharray="1 3"/>
          </g>
        </g>
      </g>
    </svg>
  </div>
  <div class="parts"><span>Cooling</span><span>Motherboard</span><span>Battery</span></div>
  <figcaption>Simplified laptop cutaway. Components vary by model.</figcaption>
</figure>
<style>
.laptop-study { margin:0; min-width:0; }.rig { overflow:hidden; }.rig svg { display:block; width:100%; height:auto; }.laptop-object { animation:laptop-hover 10s ease-in-out infinite; }.keyboard-lift { animation:keyboard-separation 10s ease-in-out infinite; }.cooling-fan { animation:fan-spin 5s linear infinite; }
.parts { display:flex; justify-content:space-between; gap:.75rem; padding:1rem 0 .5rem; border-top:1px solid var(--color-rule); color:var(--color-ink-2); font-size:.83rem; }figcaption { color:var(--color-muted); font-size:.78rem; }
@keyframes laptop-hover { 0%,100% { transform:translateY(3px); } 50% { transform:translateY(-3px); } }
@keyframes keyboard-separation { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-13px); } }
@keyframes fan-spin { to { transform:rotate(360deg); } }
@media(prefers-reduced-motion:reduce) { .laptop-object,.keyboard-lift,.cooling-fan { animation:none; } }
</style>
