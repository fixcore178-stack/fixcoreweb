---
import { business } from '../data/site';
import { socials, WHATSAPP_URL } from '../consts';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

const hasHours = business.hours.length > 0;
---

<section class="section contact" id="contact" data-hide-fab>
	<div class="wrap">
		<div class="section-head reveal">
			<span class="eyebrow">Find us</span>
			<h2>Local, and easy to <span class="grad">reach</span>.</h2>
			<p class="lead">Message us on whichever app you already use. We will take it from there.</p>
		</div>

		<div class="grid">
			<div class="info">
				<article class="glass reveal" style="--d:0">
					<span class="ico"><Icon name="pin" size={22} /></span>
					<div>
						<h3>Service area</h3>
						<p>{business.serviceArea}</p>
						<p class="sub">Tell us where you are and we will confirm how we can help.</p>
					</div>
				</article>

				<article class="glass reveal" style="--d:1">
					<span class="ico"><Icon name="clock" size={22} /></span>
					<div>
						<h3>{hasHours ? 'Opening hours' : 'Availability'}</h3>
						{
							hasHours ? (
								<ul class="hours">
									{business.hours.map((h) => (
										<li>
											<span>{h.days}</span>
											<span>{h.time}</span>
										</li>
									))}
								</ul>
							) : (
								<>
									<p>Message us any time.</p>
									<p class="sub">We will confirm when we can look at your device.</p>
								</>
							)
						}
					</div>
				</article>

				{
					business.warranty && (
						<article class="glass reveal" style="--d:2">
							<span class="ico"><Icon name="shield" size={22} /></span>
							<div>
								<h3>Warranty</h3>
								<p>{business.warranty}</p>
							</div>
						</article>
					)
				}
			</div>

			<ul class="channels">
				{
					socials.map((s, i) => (
						<li class="reveal" style={`--d:${i}`}>
							<a class="channel glass glow" data-tilt="3" href={s.href} target="_blank" rel="noopener">
								<span class={`brand b-${s.name}`}><BrandIcon name={s.name} size={24} /></span>
								<span class="ch-text">
									<b>{s.label}</b>
									<span>{s.handle}</span>
								</span>
								<Icon class="go" name="arrow" size={20} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 900px) {
		.grid {
			grid-template-columns: 1fr 1.1fr;
			gap: 1.75rem;
			align-items: start;
		}
	}
	.info {
		display: grid;
		gap: 1.25rem;
	}
	.info article {
		display: flex;
		gap: 1.1rem;
		padding: 1.5rem;
	}
	.ico {
		display: grid;
		place-items: center;
		flex: none;
		width: 3rem;
		height: 3rem;
		border-radius: 14px;
		background: color-mix(in srgb, var(--blue-strong) 16%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--blue) 28%, transparent);
		color: var(--blue);
	}
	.info h3 {
		margin-bottom: 0.35rem;
	}
	.info p {
		margin: 0;
	}
	.info .sub {
		margin-top: 0.3rem;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.hours {
		display: grid;
		gap: 0.3rem;
	}
	.hours li {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
	}
	.hours li span:last-child {
		color: var(--muted);
	}
	.channels {
		display: grid;
		gap: 0.9rem;
	}
	.channel {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 1.25rem;
		color: var(--ink);
		text-decoration: none;
		transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition:
			transform 0.5s var(--ease),
			background-color 0.3s;
	}
	.channel.tilting {
		transition:
			transform 0.1s linear,
			background-color 0.3s;
	}
	.channel:hover {
		color: var(--ink);
		background: var(--glass-hi);
	}
	.brand {
		display: grid;
		place-items: center;
		flex: none;
		width: 3.1rem;
		height: 3.1rem;
		border-radius: 50%;
		background: var(--glass-hi);
		box-shadow: inset 0 0 0 1px var(--stroke-hi);
		transition: transform 0.4s var(--ease);
	}
	.channel:hover .brand {
		transform: scale(1.1) rotate(-6deg);
	}
	.b-whatsapp {
		color: var(--wa);
	}
	.b-instagram {
		color: #ff7aa8;
	}
	.b-tiktok {
		color: var(--cyan);
	}
	.b-facebook {
		color: #6aa7ff;
	}
	.ch-text {
		display: grid;
		line-height: 1.3;
	}
	.ch-text b {
		font-family: var(--display);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.ch-text span {
		font-size: 0.92rem;
		color: var(--muted);
	}
	.channel :global(.go) {
		margin-left: auto;
		color: var(--muted);
		transition:
			transform 0.4s var(--ease),
			color 0.2s;
	}
	.channel:hover :global(.go) {
		transform: translateX(5px);
		color: var(--cyan);
	}
</style>
