---
import { SITE_TITLE, INSTAGRAM_URL, INSTAGRAM_HANDLE, FACEBOOK_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap row">
		<p>&copy; {year} {SITE_TITLE}</p>
		<p class="links">
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram {INSTAGRAM_HANDLE}</a>
			<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
		</p>
	</div>
</footer>
<style>
	footer {
		border-top: 2px solid var(--ink);
		padding-block: 1.5rem;
		font-size: 1rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
	}
	p {
		margin: 0;
		max-width: none;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
	}
</style>
