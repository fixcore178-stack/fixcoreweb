---
import { SITE_TITLE, socials, WHATSAPP_URL, WHATSAPP_DISPLAY } from '../consts';
import { services } from '../data/services';
import { business } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="foot">
	<div class="wrap">
		<div class="panel">
			<div class="col brandcol">
				<p class="title">{SITE_TITLE}</p>
				<p class="note">
					Phone and laptop repairs in {business.serviceArea}. Tell us what is wrong and we
					will send you a quote.
				</p>
				<a class="big" href={WHATSAPP_URL} target="_blank" rel="noopener">
					<span class="big-label">WhatsApp</span>
					<span class="handle-num big-num">{WHATSAPP_DISPLAY}</span>
				</a>
				<a class="btn btn-glass btn-sm" href="/#quote">
					Get a quote <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
				</a>
			</div>

			<nav class="col" aria-label="Services">
				<p class="title">Services</p>
				<ul>
					{
						services.map((s) => (
							<li>
								<a href={`/services/${s.slug}`}>{s.name}</a>
							</li>
						))
					}
					<li><a href="/about">About</a></li>
					<li><a href="/pricing">Pricing</a></li>
					<li><a href="/contact">Contact &amp; booking</a></li>
					<li><a href="/terms">Repair terms</a></li>
				</ul>
			</nav>

			<div class="col">
				<p class="title">Find us online</p>
				<ul class="social">
					{
						socials.map((s) => (
							<li>
								<a href={s.href} target="_blank" rel="noopener">
									<span class="ico"><BrandIcon name={s.name} size={17} /></span>
									<span><span class="sr-only">{s.label} </span><span class="handle-num">{s.handle}</span></span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<p class="legal">&copy; {year} {SITE_TITLE}. Proudly local to {business.serviceArea}.</p>
		<p class="legal credit">
			3D PC model &ldquo;<a href="https://sketchfab.com/3d-models/custom-gaming-pc-1a24273417534f69afa0f7c62b643ffc" target="_blank" rel="noopener">Custom Gaming PC</a>&rdquo; by
			<a href="https://sketchfab.com/Yolala1232" target="_blank" rel="noopener">Yolala1232</a>, licensed
			<a href="http://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>. Compressed for web.
		</p>
	</div>
</footer>

<style>
	.foot {
		padding: 2rem 0 7rem;
	}
	.panel {
		display: grid;
		gap: 2.5rem 3rem;
		padding: clamp(2rem, 5vw, 3.5rem) 0;
		border-top: 1px solid var(--color-rule-hi);
	}
	.big {
		display: block;
		margin: 0 0 1.5rem;
		text-decoration: none;
	}
	.big-label {
		display: block;
		margin-bottom: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-faint);
	}
	.big-num {
		display: block;
		font-size: clamp(1.6rem, 4vw, 2.4rem);
		line-height: 1.1;
		color: var(--color-accent);
		overflow-wrap: anywhere;
	}
	.big:hover .big-num {
		color: var(--color-accent-hover);
	}
	@media (min-width: 860px) {
		.panel {
			grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.1fr);
		}
	}
	.title {
		margin: 0 0 1rem;
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	.note {
		max-width: 26em;
		color: var(--muted);
		font-size: 0.97rem;
	}
	ul {
		display: grid;
		gap: 0.65rem;
	}
	.col a:not(.btn) {
		color: var(--ink-2);
		text-decoration: none;
		transition: color 0.2s;
	}
	.col a:not(.btn):hover {
		color: var(--cyan);
	}
	.social a {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
	}
	.ico {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: var(--radius-sm);
		box-shadow: inset 0 0 0 1px var(--color-rule);
		transition:
			box-shadow var(--dur-fast),
			color var(--dur-fast);
	}
	.social a:hover .ico {
		box-shadow: inset 0 0 0 1px var(--color-accent);
	}
	.legal {
		margin: 1.5rem 0 0;
		max-width: none;
		text-align: center;
		font-size: 0.88rem;
		color: var(--faint);
	}
	.credit {
		margin-top: 0.4rem;
	}
	.credit a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
</style>
