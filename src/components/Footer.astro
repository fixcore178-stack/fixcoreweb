---
import { SITE_TITLE, socials } from '../consts';
import { services } from '../data/services';
import { business } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="foot">
	<div class="wrap">
		<div class="panel glass">
			<div class="col brandcol">
				<p class="title">{SITE_TITLE}</p>
				<p class="note">
					Phone and laptop repairs in {business.serviceArea}. Tell us what is wrong and we
					will send you a quote.
				</p>
				<a class="btn btn-primary btn-sm" href="/#quote">
					Get a quote <Icon class="arrow" name="arrow" size={16} stroke={2.2} />
				</a>
			</div>

			<nav class="col" aria-label="Services">
				<p class="title">Services</p>
				<ul>
					{
						services.map((s) => (
							<li>
								<a href={`/services/${s.slug}`}>{s.name}</a>
							</li>
						))
					}
					<li><a href="/about">About</a></li>
				</ul>
			</nav>

			<div class="col">
				<p class="title">Find us online</p>
				<ul class="social">
					{
						socials.map((s) => (
							<li>
								<a href={s.href} target="_blank" rel="noopener">
									<span class="ico"><BrandIcon name={s.name} size={17} /></span>
									<span><span class="sr-only">{s.label} </span><span class="handle-num">{s.handle}</span></span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<p class="legal">&copy; {year} {SITE_TITLE}. Proudly local to {business.serviceArea}.</p>
	</div>
</footer>

<style>
	.foot {
		padding: 2rem 0 7rem;
	}
	.panel {
		display: grid;
		gap: 2.5rem 3rem;
		padding: clamp(1.5rem, 4vw, 2.75rem);
	}
	@media (min-width: 860px) {
		.panel {
			grid-template-columns: 1.5fr 1fr 1.1fr;
		}
	}
	.title {
		margin: 0 0 1rem;
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	.note {
		max-width: 26em;
		color: var(--muted);
		font-size: 0.97rem;
	}
	ul {
		display: grid;
		gap: 0.65rem;
	}
	.col a:not(.btn) {
		color: var(--ink-2);
		text-decoration: none;
		transition: color 0.2s;
	}
	.col a:not(.btn):hover {
		color: var(--cyan);
	}
	.social a {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
	}
	.ico {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		transition:
			background-color 0.2s,
			transform 0.3s var(--ease);
	}
	.social a:hover .ico {
		background: var(--glass-hi);
		transform: translateY(-2px);
	}
	.legal {
		margin: 1.5rem 0 0;
		max-width: none;
		text-align: center;
		font-size: 0.88rem;
		color: var(--faint);
	}
</style>
