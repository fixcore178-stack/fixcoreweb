---
// Exploded, isometric device models built from real 3D boxes projected to SVG.
const C = 0.866, S = 0.5;
const f = (n: number) => n.toFixed(1);
const P = (x: number, y: number, z: number): [number, number] => [(x - y) * C, (x + y) * S - z];
const pt = (a: [number, number][]) => a.map((p) => `${f(p[0])},${f(p[1])}`).join(' ');
type Pal = { t: string; l: string; r: string; s: string };
const pal: Record<string, Pal> = {
  metal: { t: '#aabdc8', l: '#6c8493', r: '#4d6675', s: '#d0dde4' },
  steel: { t: '#7d93a1', l: '#52697a', r: '#3a4f5e', s: '#a9bdc8' },
  dark: { t: '#2c4352', l: '#1b2d3a', r: '#14232e', s: '#5f7a8a' },
  pcb: { t: '#2f6b5f', l: '#214b43', r: '#193b35', s: '#86b7aa' },
  chip: { t: '#3e576c', l: '#28394a', r: '#1d2c3a', s: '#8ca9bb' },
  cell: { t: '#566c7a', l: '#33444f', r: '#25333c', s: '#93a9b6' },
  glass: { t: '#17465c', l: '#0f3142', r: '#0a2432', s: '#6fa5ba' },
  copper: { t: '#d2ad70', l: '#9d7d4c', r: '#7a5e3b', s: '#ecd29c' },
  cyan: { t: '#59d8e6', l: '#2d9cae', r: '#207686', s: '#b8f2f8' },
  key: { t: '#516c7d', l: '#2c404e', r: '#22323e', s: '#8ba7b9' },
};
const st = (p: Pal) => `stroke="${p.s}" stroke-width=".55" stroke-linejoin="round"`;
const box = (x: number, y: number, z: number, w: number, d: number, h: number, p: Pal) => {
  const top = [P(x, y, z + h), P(x + w, y, z + h), P(x + w, y + d, z + h), P(x, y + d, z + h)];
  const left = [P(x, y + d, z + h), P(x + w, y + d, z + h), P(x + w, y + d, z), P(x, y + d, z)];
  const right = [P(x + w, y, z + h), P(x + w, y + d, z + h), P(x + w, y + d, z), P(x + w, y, z)];
  return `<polygon points="${pt(left)}" fill="${p.l}" ${st(p)}/><polygon points="${pt(right)}" fill="${p.r}" ${st(p)}/><polygon points="${pt(top)}" fill="${p.t}" ${st(p)}/>`;
};
const quadZ = (z: number, x0: number, y0: number, x1: number, y1: number, fill: string, o = 1) =>
  `<polygon points="${pt([P(x0, y0, z), P(x1, y0, z), P(x1, y1, z), P(x0, y1, z)])}" fill="${fill}" opacity="${o}"/>`;
const quadX = (x: number, y0: number, z0: number, y1: number, z1: number, fill: string, o = 1) =>
  `<polygon points="${pt([P(x, y0, z0), P(x, y1, z0), P(x, y1, z1), P(x, y0, z1)])}" fill="${fill}" opacity="${o}"/>`;
const quadY = (y: number, x0: number, z0: number, x1: number, z1: number, fill: string, o = 1) =>
  `<polygon points="${pt([P(x0, y, z0), P(x1, y, z0), P(x1, y, z1), P(x0, y, z1)])}" fill="${fill}" opacity="${o}"/>`;
const cyl = (cx: number, cy: number, z: number, r: number, h: number, p: Pal) => {
  const [X, Y] = P(cx, cy, z + h);
  const rx = 1.2247 * r, ry = 0.7071 * r;
  return `<path d="M${f(X - rx)} ${f(Y)}v${h}a${f(rx)} ${f(ry)} 0 0 0 ${f(2 * rx)} 0v${-h}z" fill="${p.l}" ${st(p)}/><ellipse cx="${f(X)}" cy="${f(Y)}" rx="${f(rx)}" ry="${f(ry)}" fill="${p.t}" ${st(p)}/>`;
};
const blades = (r: number, n = 7) =>
  Array.from({ length: n }, (_, i) =>
    `<path d="M0 0C${f(r * 0.25)} ${f(-r * 0.45)} ${f(r * 0.7)} ${f(-r * 0.85)} ${f(r * 0.88)} ${f(-r * 0.4)}C${f(r * 0.55)} ${f(-r * 0.32)} ${f(r * 0.2)} ${f(-r * 0.08)} 0 0Z" transform="rotate(${f((i * 360) / n)})" fill="#8fb0bf" stroke="#cfe0e8" stroke-width=".4"/>`
  ).join('');
const fanZ = (cx: number, cy: number, z: number, r: number) => {
  const [X, Y] = P(cx, cy, z);
  return `<g transform="matrix(${C} ${S} ${-C} ${S} ${f(X)} ${f(Y)})"><circle r="${r}" fill="#142733" stroke="#6f8a9a" stroke-width="1.2"/><g class="dis-spin">${blades(r)}</g><circle r="${f(r * 0.26)}" fill="#c3d4dc" stroke="#35505f" stroke-width="1"/></g>`;
};
const fanX = (x: number, cy: number, cz: number, r: number) => {
  const [X, Y] = P(x, cy, cz);
  return `<g transform="matrix(${-C} ${S} 0 -1 ${f(X)} ${f(Y)})"><circle r="${r}" fill="#142733" stroke="#6f8a9a" stroke-width="1.2"/><g class="dis-spin">${blades(r)}</g><circle r="${f(r * 0.26)}" fill="#c3d4dc" stroke="#35505f" stroke-width="1"/></g>`;
};

type Part = { n: string; d: string; g: string; b: [number, number, number] };

// ---------------- PHONE ----------------
const W = 72, D = 140;
const phone: Part[] = [
  { n: 'Back glass & camera', d: 'Rear glass panel with the camera bump. Cracks here are common after drops.',
    g: box(0, 0, 0, W, D, 4, pal.metal) + box(7, 7, 4, 30, 30, 3, pal.dark) + cyl(17, 17, 7, 5.5, 2, pal.glass) + cyl(28, 17, 7, 5.5, 2, pal.glass) + cyl(17, 28, 7, 5.5, 2, pal.glass) + cyl(29, 29, 7, 2, 1.5, pal.copper), b: [50, 100, 4] },
  { n: 'Mid-frame', d: 'The metal chassis that holds every component and the side buttons.',
    g: box(0, 0, 44, W, D, 5, pal.steel) + quadZ(49, 5, 5, W - 5, D - 5, '#1a2c39') + box(W, 38, 45, 2.5, 16, 3, pal.metal) + box(W, 62, 45, 2.5, 22, 3, pal.metal), b: [W - 6, 120, 49] },
  { n: 'Charging port board', d: 'Small board with the charging port and microphone. Worn ports stop charging.',
    g: box(10, 116, 96, 52, 20, 2, pal.pcb) + box(24, 133, 97, 24, 7, 4, pal.dark) + box(12, 120, 98, 6, 6, 2, pal.chip), b: [40, 124, 102] },
  { n: 'Logic board', d: 'The main board: processor, memory and storage live here.',
    g: box(8, 8, 96, 56, 38, 3, pal.pcb) + box(14, 14, 99, 20, 20, 2.5, pal.chip) + box(38, 14, 99, 14, 14, 2, pal.chip) + box(38, 32, 99, 18, 8, 1.5, pal.copper) + box(54, 12, 99, 6, 24, 1.5, pal.dark), b: [30, 24, 102] },
  { n: 'Battery', d: 'Lithium-ion cell. A tired battery is the most common phone repair.',
    g: box(8, 52, 96, 56, 58, 4.5, pal.cell) + quadZ(100.6, 12, 62, 60, 84, '#26373f') + quadZ(100.7, 12, 90, 60, 94, '#59d8e6', 0.7), b: [36, 74, 101] },
  { n: 'Display panel', d: 'The screen itself. Cracked or lined screens are replaced as one unit.',
    g: box(2, 2, 196, W - 4, D - 4, 3, pal.glass) + quadZ(199.2, 6, 10, 66, 40, '#59d8e6', 0.55) + quadZ(199.3, 6, 70, 66, 100, '#2d8ea3', 0.7), b: [36, 120, 199] },
  { n: 'Cover glass', d: 'Protective front glass with the speaker and front camera cut-out.',
    g: box(0, 0, 250, W, D, 2, pal.dark) + quadZ(252.2, 4, 4, W - 4, D - 4, '#0b2230') + `<polygon points="${pt([P(22, 8, 252.4), P(50, 8, 252.4), P(50, 14, 252.4), P(22, 14, 252.4)])}" fill="#050f18"/>`, b: [36, 124, 252] },
];

// ---------------- LAPTOP ----------------
const LW = 150, LD = 104;
const keyRows = Array.from({ length: 5 }, (_, r) =>
  Array.from({ length: 12 }, (_, c) => box(8 + c * 11.5, 8 + r * 9.6, 123, 9.8, 7.6, 1.8, pal.key)).join('')
).join('');
const laptop: Part[] = [
  { n: 'Bottom case', d: 'Base cover with vents and rubber feet. Removed first to reach everything.',
    g: box(0, 0, 0, LW, LD, 6, pal.metal) + quadZ(6, 6, 6, LW - 6, LD - 6, '#1a2c39') + [0, 1, 2, 3, 4].map((i) => quadZ(6.1, 112 + i * 5, 14, 114.5 + i * 5, 40, '#0f1c26')).join(''), b: [20, 90, 6] },
  { n: 'Motherboard', d: 'Main board with processor, memory and the M.2 storage slot.',
    g: box(10, 8, 50, 100, 50, 3, pal.pcb) + box(54, 20, 53, 24, 24, 3, pal.chip) + quadZ(56.1, 58, 24, 74, 40, '#7f99a8', 0.9) + box(14, 12, 53, 32, 8, 2, pal.chip) + box(14, 24, 53, 32, 8, 2, pal.chip) + box(14, 40, 53, 38, 10, 2, pal.dark) + quadZ(55.1, 17, 42.5, 28, 47.5, '#d2ad70'), b: [90, 48, 53] },
  { n: 'Cooling module', d: 'Heat pipe and fan. Dust here is why laptops run hot and loud.',
    g: box(76, 28, 56, 40, 6, 3, pal.copper) + box(110, 12, 50, 38, 38, 8, pal.steel) + fanZ(129, 31, 58.2, 15), b: [130, 48, 58] },
  { n: 'Battery', d: 'Internal battery pack. Swapped when run time collapses.',
    g: box(10, 66, 50, 92, 32, 5, pal.cell) + quadZ(55.2, 14, 72, 98, 80, '#26373f') + quadZ(55.3, 14, 86, 98, 90, '#59d8e6', 0.7), b: [56, 92, 55] },
  { n: 'Speakers', d: 'Stereo speaker pair that sits beside the battery.',
    g: box(108, 66, 50, 34, 32, 5, pal.dark) + [0, 1, 2, 3].map((i) => quadZ(55.2, 114 + i * 6, 72, 116 + i * 6, 92, '#0c1822')).join(''), b: [125, 92, 55] },
  { n: 'Keyboard & trackpad', d: 'Top deck with every key and the trackpad. Spills usually get here first.',
    g: box(0, 0, 118, LW, LD, 4, pal.metal) + quadZ(122, 5, 5, LW - 5, 64, '#3c5463') + keyRows + quadZ(122.1, 50, 70, 100, 98, '#8aa0ad') + `<polygon points="${pt([P(50, 70, 122.2), P(100, 70, 122.2), P(100, 98, 122.2), P(50, 98, 122.2)])}" fill="none" stroke="#c4d3db" stroke-width=".7"/>`, b: [20, 96, 122] },
  { n: 'Screen assembly', d: 'Display panel, bezel and webcam in the lid. A cracked panel is swapped here.',
    g: box(0, -10, 190, LW, 4, 96, pal.steel) + box(0, -6, 190, LW, 5, 96, pal.metal) + quadY(-1, 6, 196, LW - 6, 280, '#0f3142') + quadY(-0.9, 6, 200, LW - 6, 236, '#59d8e6', 0.5) + quadY(-0.9, 6, 244, LW - 6, 274, '#2d8ea3', 0.7) + quadY(-0.8, 70, 283, 80, 285, '#050f18'), b: [75, -1, 280] },
];

// ---------------- DESKTOP ----------------
const desktop: Part[] = [
  { n: 'Case & motherboard tray', d: 'The steel chassis. Everything mounts to it, and it carries the dust filters.',
    g: box(0, 0, 0, 5, 112, 152, pal.steel) + [0, 1, 2, 3, 4, 5].map((i) => quadX(5, 76, 14 + i * 8, 106, 18 + i * 8, '#0f1c26')).join(''), b: [5, 20, 146] },
  { n: 'Motherboard', d: 'Connects every component. Holds the CPU socket, memory slots and ports.',
    g: box(40, 6, 40, 4, 100, 108, pal.pcb) + box(44, 8, 100, 8, 20, 44, pal.steel) + box(44, 10, 58, 3, 60, 5, pal.dark) + box(44, 84, 92, 3, 6, 46, pal.dark) + box(44, 92, 92, 3, 6, 46, pal.dark) + quadX(44, 46, 98, 68, 120, '#8ea6b4', 0.45), b: [44, 90, 70] },
  { n: 'Graphics card', d: 'Draws games, video and 3D. Heavy gaming heat comes from here.',
    g: box(40, 10, -48, 70, 28, 20, pal.dark) + fanZ(62, 24, -27.8, 11) + fanZ(90, 24, -27.8, 11) + quadZ(-27.9, 40, 12, 110, 14, '#59d8e6', 0.6), b: [100, 24, -28] },
  { n: 'Power supply', d: 'Converts wall power for every part. Failing units cause random shutdowns.',
    g: box(40, 60, -100, 44, 44, 34, pal.dark) + fanX(84, 82, -83, 15) + quadX(84, 64, -71, 100, -68, '#d2ad70', 0.8), b: [84, 70, -66] },
  { n: 'Memory (RAM)', d: 'Short-term memory. More RAM keeps many apps running smoothly.',
    g: [0, 1].map((i) => box(62, 84 + i * 8, 92, 3, 6, 46, pal.pcb) + quadX(65, 84.8 + i * 8, 98, 88.2 + i * 8, 108, '#3e576c') + quadX(65, 84.8 + i * 8, 112, 88.2 + i * 8, 122, '#3e576c')).join(''), b: [64, 90, 138] },
  { n: 'Processor (CPU)', d: 'The brain of the PC. Sits in the socket under the cooler.',
    g: box(80, 46, 98, 3, 22, 22, pal.copper) + quadX(83, 50, 102, 64, 116, '#8ea6b4'), b: [83, 57, 120] },
  { n: 'CPU cooler', d: 'Heatsink and fan. Old thermal paste or dust causes overheating.',
    g: box(110, 36, 86, 22, 38, 44, pal.metal) + [0, 1, 2, 3, 4, 5, 6].map((i) => quadX(132, 38 + i * 5.2, 88, 40 + i * 5.2, 128, '#6c8493')).join('') + fanX(132, 55, 108, 17), b: [132, 55, 130] },
  { n: 'Storage drive', d: 'SSD or hard drive that holds Windows and your files.',
    g: box(124, 8, -20, 14, 44, 24, pal.chip) + quadX(138, 12, -16, 48, 0, '#7f99a8', 0.5) + quadX(138, 12, -16, 48, -10, '#59d8e6', 0.6), b: [138, 30, 4] },
];

const devices = [
  { id: 'phone', label: 'Phone', vb: '-135 -285 210 405', cx: -30, cy: 112, parts: phone },
  { id: 'laptop', label: 'Laptop', vb: '-115 -320 270 470', cx: 20, cy: 132, parts: laptop },
  { id: 'desktop', label: 'Desktop PC', vb: '-125 -180 270 410', cx: 5, cy: 200, parts: desktop },
];
---
<div class="dis" data-dis>
  <div class="dis-tabs" role="tablist" aria-label="Choose a device">
    {devices.map((d, i) => (<button class="dis-tab" role="tab" type="button" data-dis-tab={d.id} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>))}
  </div>
  {devices.map((d, di) => (
    <div class="dis-panel" data-dis-panel={d.id} hidden={di !== 0}>
      <div class="dis-stage" data-motion-scene>
        <svg viewBox={d.vb} role="img" aria-label={`Exploded view of a ${d.label.toLowerCase()} with ${d.parts.length} numbered parts`}>
          <ellipse cx={d.cx} cy={d.cy} rx="95" ry="11" fill="#000" opacity=".18" />
          {d.parts.map((p, i) => (
            <g class="dis-part" data-part={`${d.id}-${i}`} style={`--i:${i}`}><g set:html={p.g} /></g>
          ))}
          {d.parts.map((p, i) => {
            const [bx, by] = P(p.b[0], p.b[1], p.b[2]);
            return (
              <g class="dis-pin" data-part={`${d.id}-${i}`} style={`--i:${i}`}>
                <g class="dis-badge" transform={`translate(${f(bx)} ${f(by - 12)})`}><line y1="2" y2="12" /><circle r="8.5" /><text y="3.4" text-anchor="middle">{i + 1}</text></g>
              </g>
            );
          })}
        </svg>
      </div>
      <ol class="dis-legend">
        {d.parts.map((p, i) => (
          <li data-part={`${d.id}-${i}`}><span class="dis-num">{i + 1}</span><div><b>{p.n}</b><span>{p.d}</span></div></li>
        ))}
      </ol>
    </div>
  ))}
  <p class="dis-note">Simplified illustration. Layout and parts vary by model.</p>
</div>
<style is:global>
.dis-tabs { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.5rem; }
.dis-tab { min-height:44px; padding:.6rem 1.2rem; background:var(--color-paper-2); color:var(--color-ink-2); border:1px solid var(--color-rule-hi); border-radius:6px; font:600 .9rem var(--font-body); cursor:pointer; }
.dis-tab:hover { border-color:var(--color-accent); color:var(--color-ink); }
.dis-tab[aria-selected='true'] { background:var(--color-accent); color:#04141b; border-color:var(--color-accent); }
.dis-panel { display:grid; gap:1.5rem; align-items:center; }
.dis-panel[hidden] { display:none; }
.dis-stage { min-width:0; border:1px solid var(--color-rule-hi); border-radius:12px; background:var(--color-paper-2); overflow:hidden; }
.dis-stage svg { display:block; width:100%; height:clamp(460px,78vh,820px); }
.dis-part, .dis-pin { animation:dis-float 7s ease-in-out infinite; animation-delay:calc(var(--i) * -.9s); cursor:pointer; transition:filter .2s; }
.dis-pin { pointer-events:none; }
.dis-part:hover, .dis-part.is-on, .dis-pin.is-on { filter:drop-shadow(0 0 7px #4bdcea); }
.dis-spin { animation:dis-spin 3.5s linear infinite; }
.dis-badge circle { fill:#4bdcea; stroke:#04141b; stroke-width:1.2; }
.dis-badge text { fill:#04141b; font:700 10px var(--font-body, sans-serif); }
.dis-badge line { stroke:#4bdcea; stroke-width:1.2; }
.dis-legend { list-style:none; margin:0; padding:0; display:grid; gap:.25rem; }
.dis-legend li { display:flex; gap:.9rem; align-items:flex-start; padding:.75rem .5rem; border-bottom:1px solid var(--color-rule); border-radius:6px; cursor:default; }
.dis-legend li.is-on { background:var(--color-paper-3); }
.dis-legend b { display:block; color:var(--color-ink); font-size:.95rem; }
.dis-legend li span:not(.dis-num) { color:var(--color-muted); font-size:.85rem; }
.dis-num { flex:0 0 1.7rem; height:1.7rem; display:grid; place-items:center; border-radius:50%; background:var(--color-accent); color:#04141b; font:700 .8rem var(--font-body); }
.dis-note { color:var(--color-muted); font-size:.78rem; margin:1rem 0 0; }
@keyframes dis-float { 0%,100% { translate:0 3px; } 50% { translate:0 -5px; } }
@keyframes dis-spin { to { transform:rotate(360deg); } }
@media(min-width:1000px) { .dis-panel { grid-template-columns:1.25fr 1fr; gap:2.5rem; } }
@media(prefers-reduced-motion:reduce) { .dis-part,.dis-pin,.dis-spin { animation:none; } }
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-dis]').forEach((root) => {
  const tabs = root.querySelectorAll<HTMLButtonElement>('[data-dis-tab]');
  const panels = root.querySelectorAll<HTMLElement>('[data-dis-panel]');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    panels.forEach((p) => { p.hidden = p.dataset.disPanel !== tab.dataset.disTab; });
  }));
  const set = (key: string | undefined, on: boolean) => root.querySelectorAll(`[data-part="${key}"]`).forEach((el) => el.classList.toggle('is-on', on));
  root.querySelectorAll<HTMLElement>('[data-part]').forEach((el) => {
    el.addEventListener('pointerenter', () => set(el.dataset.part, true));
    el.addEventListener('pointerleave', () => set(el.dataset.part, false));
  });
});
</script>
