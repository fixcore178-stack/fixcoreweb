---
import { brandIcons, type BrandIconName } from '../data/brand-icons';

interface Props {
	name: BrandIconName;
	size?: number;
	class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
	<path d={brandIcons[name]}></path>
</svg>
