---
interface Props {
	items: { q: string; a: string }[];
	prefix?: string;
}
const { items, prefix = 'faq' } = Astro.props;
---

<div class="faq" data-faq>
	{
		items.map((it, i) => (
			<div class="item glass reveal" style={`--d:${Math.min(i, 5)}`} data-item>
				<h3>
					<button type="button" id={`${prefix}-q${i}`} aria-expanded="false" aria-controls={`${prefix}-a${i}`}>
						<span>{it.q}</span>
						<span class="plus" aria-hidden="true"><i></i><i></i></span>
					</button>
				</h3>
				<div class="panel" id={`${prefix}-a${i}`} role="region" aria-labelledby={`${prefix}-q${i}`}>
					<div class="inner">
						<p>{it.a}</p>
					</div>
				</div>
			</div>
		))
	}
</div>

<style>
	.faq {
		display: grid;
		gap: 0.75rem;
	}
	.item {
		--r: 20px;
		transition:
			background-color 0.3s,
			box-shadow 0.3s;
	}
	.item:hover,
	.item.open {
		background: var(--glass-hi);
	}
	h3 {
		margin: 0;
		font-size: inherit;
	}
	button {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		padding: 1.2rem 1.4rem;
		border: 0;
		border-radius: inherit;
		background: none;
		color: var(--ink);
		font-family: var(--display);
		font-weight: 600;
		font-size: clamp(1rem, 1.6vw, 1.12rem);
		letter-spacing: -0.02em;
		text-align: left;
		cursor: pointer;
	}
	.plus {
		position: relative;
		flex: none;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 50%;
		background: var(--glass);
		box-shadow: inset 0 0 0 1px var(--stroke);
		transition:
			background 0.3s,
			transform 0.5s var(--ease);
	}
	.plus i {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 0.7rem;
		height: 2px;
		margin: -1px 0 0 -0.35rem;
		border-radius: 2px;
		background: var(--cyan);
		transition: transform 0.5s var(--ease);
	}
	.plus i:last-child {
		transform: rotate(90deg);
	}
	.open .plus {
		background: var(--accent-grad);
		transform: rotate(180deg);
	}
	.open .plus i {
		background: var(--on-accent);
	}
	.open .plus i:last-child {
		transform: rotate(0deg);
	}
	/* Height animates by growing a grid row from 0fr to 1fr, so no JS measuring is needed */
	.panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.5s var(--ease);
	}
	.open .panel {
		grid-template-rows: 1fr;
	}
	.inner {
		overflow: hidden;
		opacity: 0;
		transition: opacity 0.35s;
	}
	.open .inner {
		opacity: 1;
		transition-delay: 0.1s;
	}
	.inner p {
		margin: 0;
		padding: 0 1.4rem 1.3rem;
		color: var(--muted);
		max-width: 46em;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
		list.querySelectorAll<HTMLElement>('[data-item]').forEach((item) => {
			const btn = item.querySelector<HTMLButtonElement>('button');
			const panel = item.querySelector<HTMLElement>('.panel');
			if (!btn || !panel) return;
			// Collapsed answers are removed from the tab order and accessibility tree
			panel.toggleAttribute('inert', true);
			btn.addEventListener('click', () => {
				const open = btn.getAttribute('aria-expanded') !== 'true';
				btn.setAttribute('aria-expanded', String(open));
				item.classList.toggle('open', open);
				panel.toggleAttribute('inert', !open);
			});
		});
	});
</script>
